@Component
script LexioTableRegistry extends Component

	property table seatOwnerByKey = {}

	property table seatByUserId = {}

	property table playerByUserId = {}

	property table queueUserIds = {}

	property table queuedByUserId = {}

	property table queuePreferenceByUserId = {}

	property table spectatorTableByUserId = {}

	property table privateRoomByCode = {}

	property table privateRoomCodeByUserId = {}

	property table privateRoomCodeByTableId = {}

	property integer privateRoomSequence = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self._T.MatchRetryElapsed = 0
		self._T.DynamicHosts = {}
		self._T.DynamicCapacities = {}
		self._T.DynamicSequence = 0
		self.seatOwnerByKey = {}
		self.seatByUserId = {}
		self.playerByUserId = {}
		self.queueUserIds = {}
		self.queuedByUserId = {}
		self.queuePreferenceByUserId = {}
		self.spectatorTableByUserId = {}
		self.privateRoomByCode = {}
		self.privateRoomCodeByUserId = {}
		self.privateRoomCodeByTableId = {}
		self.privateRoomSequence = 0
		log("[VRF] ROOM REGISTRY ready dynamic_sessions=true")
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		self._T.MatchRetryElapsed = (self._T.MatchRetryElapsed or 0) + delta
		if self._T.MatchRetryElapsed < 1 then return end
		self._T.MatchRetryElapsed = 0
		if #self.queueUserIds > 0 then self:TryMatchQueue()
		else self:CleanupIdleDynamicSessions() end
	end

	@ExecSpace("ServerOnly")
	method boolean ReconnectPlayer(string userId, Entity playerEntity)
		if not self:IsPlayerInGameRoom(playerEntity) or playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return false end
		local seat = self.seatByUserId[userId]
		if seat == nil then return false end
		local coordinator = self:GetTableCoordinator(seat.tableId)
		if coordinator == nil then return false end
		local alreadyConnected = coordinator.playerEntityBySeat[seat.seatIndex] == playerEntity and coordinator._T.DisconnectedSeconds[seat.seatIndex] == nil and not coordinator._T.KickedBySeat[seat.seatIndex]
		if not alreadyConnected and not coordinator:ReconnectTablePlayer(userId, playerEntity) then return false end
		self.playerByUserId[userId] = playerEntity
		local code = self.privateRoomCodeByUserId[userId]
		local room = code ~= nil and self.privateRoomByCode[code] or nil
		local controls = playerEntity:GetComponent("script.LexioManualTestControls")
		if controls ~= nil then controls:ApplyResumedGame(room ~= nil and self:BuildPrivateRoomSnapshot(room, userId) or nil, seat.chairName, userId) end
		coordinator:BroadcastSnapshots()
		return true
	end

	@ExecSpace("ServerOnly")
	method void DetachReplacedPlayer(string userId, string tableId, integer seatIndex)
		local seat = self.seatByUserId[userId]
		if seat == nil or seat.tableId ~= tableId or seat.seatIndex ~= seatIndex then return end
		local player = self.playerByUserId[userId]
		local controls = player ~= nil and isvalid(player) and player:GetComponent("script.LexioManualTestControls") or nil
		if controls ~= nil then controls:ShowFinishedLobby(userId) end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator ~= nil and coordinator._T.SuspendedPlayers ~= nil then coordinator._T.SuspendedPlayers[seatIndex] = nil end
		self.seatOwnerByKey[seat.key] = "AI:" .. userId
		self.seatByUserId[userId] = nil
		self.playerByUserId[userId] = nil
		local code = self.privateRoomCodeByUserId[userId]
		local room = code ~= nil and self.privateRoomByCode[code] or nil
		self.privateRoomCodeByUserId[userId] = nil
		if room ~= nil then
			for index = #room.userIds, 1, -1 do if room.userIds[index] == userId then table.remove(room.userIds, index) end end
			room.seatByUserId[userId] = nil
			room.readyByUserId[userId] = nil
			if room.ownerUserId == userId then room.ownerUserId = room.userIds[1] or "" end
			if not self:DestroyEmptyPrivateRoom(room) then self:BroadcastPrivateRoomSnapshot(room) end
		end
		log("[VRF] PRIVATE PLAYER replaced table=" .. tableId .. " seat=" .. tostring(seatIndex))
	end

	@ExecSpace("ServerOnly")
	method void ReleaseReplacedSeat(string userId, string tableId, integer seatIndex)
		local key = self:MakeSeatKey(tableId, seatIndex)
		if self.seatOwnerByKey[key] == "AI:" .. userId then self.seatOwnerByKey[key] = nil end
	end

	method boolean IsPlayerInGameRoom(Entity playerEntity)
		if playerEntity == nil or not isvalid(playerEntity) or playerEntity.CurrentMap == nil then return false end
		local host = playerEntity.CurrentMap:GetChildByName("LexioManualSessionHost")
		return host ~= nil and host:GetComponent("script.LexioTableRegistry") ~= nil
	end

	@ExecSpace("ServerOnly")
	method boolean SetSpectatorTable(string userId, Entity playerEntity, string tableId)
		if userId == nil or userId == "" or playerEntity == nil or not isvalid(playerEntity) then return false end
		if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return false end
		if not self:IsPlayerInGameRoom(playerEntity) then return false end
		if self.seatByUserId[userId] ~= nil or self.queuedByUserId[userId] then return false end
		local previous = self.spectatorTableByUserId[userId]
		if previous ~= nil then
			local previousCoordinator = self:GetTableCoordinator(previous)
			if previousCoordinator ~= nil then previousCoordinator:ReleaseTableSpectator(userId) end
			self.spectatorTableByUserId[userId] = nil
		end
		if tableId == "" then
			local lobbyCoordinator = self.Entity:GetComponent("script.LexioSessionCoordinator")
			if lobbyCoordinator ~= nil then lobbyCoordinator:AttachBridge(playerEntity, userId, 0, "Spectator") end
			return true
		end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil or not coordinator:RegisterTableSpectator(playerEntity, userId, tableId) then return false end
		self.spectatorTableByUserId[userId] = tableId
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean IsTableEmpty(string tableId)
		if self.privateRoomCodeByTableId[tableId] ~= nil then return false end
		for seatIndex = 1, self:GetRequiredPlayerCount(tableId) do
			if self.seatOwnerByKey[self:MakeSeatKey(tableId, seatIndex)] ~= nil then return false end
		end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil then return false end
		local session = coordinator.SessionEntity:GetComponent("script.LexioGameSession")
		return session ~= nil and session.phase == "WaitingPlayers" and not coordinator.startRequested
	end

	method string GetTableIdForCapacity(integer capacity)
		local legacyId = capacity == 3 and "table01" or (capacity == 4 and "table02" or (capacity == 5 and "table03" or ""))
		if legacyId == "" then return "" end
		if self:IsTableEmpty(legacyId) then return legacyId end
		for tableId, size in pairs(self._T.DynamicCapacities or {}) do
			if size == capacity and self:IsTableEmpty(tableId) then return tableId end
		end
		return self:CreateDynamicSession(capacity)
	end

	method string NextPrivateRoomCode()
		self.privateRoomSequence = self.privateRoomSequence + 1
		if self.privateRoomSequence > 999 then self.privateRoomSequence = 1 end
		local suffix = tostring(self.privateRoomSequence)
		while #suffix < 3 do suffix = "0" .. suffix end
		return "L" .. suffix
	end

	@ExecSpace("ServerOnly")
	method table CreatePrivateRoom(string userId, Entity playerEntity, string title, integer capacity, string password)
		local rejected = { ok = false, reason = "invalid_request" }
		if userId == nil or userId == "" or playerEntity == nil or not isvalid(playerEntity) then return rejected end
		if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId or not self:IsPlayerInGameRoom(playerEntity) then return rejected end
		if self.privateRoomCodeByUserId[userId] ~= nil or self.seatByUserId[userId] ~= nil then return { ok = false, reason = "already_in_room" } end
		if title == nil or title == "" or #title > 20 or password == nil or #password > 8 then return rejected end
		if capacity ~= 3 and capacity ~= 4 and capacity ~= 5 then return { ok = false, reason = "invalid_capacity" } end
		local tableId = self:GetTableIdForCapacity(capacity)
		if tableId == "" then return { ok = false, reason = "session_unavailable" } end
		if not self:IsTableEmpty(tableId) then return { ok = false, reason = "capacity_busy" } end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil then return { ok = false, reason = "missing_coordinator" } end
		local code = self:NextPrivateRoomCode()
		if not coordinator:ActivatePrivateRoom(code) then return { ok = false, reason = "activation_failed" } end
		local room = { code = code, title = title, capacity = capacity, password = password, ownerUserId = userId, tableId = tableId, userIds = { userId }, seatByUserId = { [userId] = 1 }, readyByUserId = { [userId] = false } }
		self.privateRoomByCode[code] = room
		self.privateRoomCodeByUserId[userId] = code
		self.privateRoomCodeByTableId[tableId] = code
		self:CancelQueue(userId)
		if not self:ReserveQueuedSeat(userId, playerEntity, tableId, 1) then
			self.privateRoomByCode[code] = nil
			self.privateRoomCodeByUserId[userId] = nil
			self.privateRoomCodeByTableId[tableId] = nil
			coordinator:DeactivatePrivateRoom(code)
			return { ok = false, reason = "seat_failed" }
		end
		log("[VRF] PRIVATE ROOM CREATED code=" .. code .. " table=" .. tableId .. " capacity=" .. tostring(capacity) .. " owner=" .. userId)
		self:BroadcastPrivateRoomSnapshot(room)
		return { ok = true, reason = "", room = self:BuildPrivateRoomSnapshot(room, userId) }
	end

	method integer FindPrivateRoomOpenSeat(table room)
		if room == nil then return 0 end
		local occupied = {}
		for _, seatIndex in pairs(room.seatByUserId) do occupied[seatIndex] = true end
		for seatIndex = 1, room.capacity do if not occupied[seatIndex] then return seatIndex end end
		return 0
	end

	@ExecSpace("ServerOnly")
	method table JoinPrivateRoom(string userId, Entity playerEntity, string code, string password)
		local room = self.privateRoomByCode[code]
		if room == nil then return { ok = false, reason = "room_not_found" } end
		if userId == nil or userId == "" or playerEntity == nil or not isvalid(playerEntity) then return { ok = false, reason = "invalid_request" } end
		if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId or not self:IsPlayerInGameRoom(playerEntity) then return { ok = false, reason = "invalid_request" } end
		if self.privateRoomCodeByUserId[userId] ~= nil or self.seatByUserId[userId] ~= nil then return { ok = false, reason = "already_in_room" } end
		if room.password ~= "" and room.password ~= password then return { ok = false, reason = "wrong_password" } end
		local coordinator = self:GetTableCoordinator(room.tableId)
		local session = coordinator ~= nil and coordinator.SessionEntity:GetComponent("script.LexioGameSession") or nil
		if session == nil or session.phase ~= "WaitingPlayers" or coordinator.startRequested or coordinator.startCountdownActive then return { ok = false, reason = "room_in_progress" } end
		if #room.userIds >= room.capacity then return { ok = false, reason = "room_full" } end
		local seatIndex = self:FindPrivateRoomOpenSeat(room)
		if seatIndex == 0 then return { ok = false, reason = "room_full" } end
		if not self:ReserveQueuedSeat(userId, playerEntity, room.tableId, seatIndex) then return { ok = false, reason = "seat_failed" } end
		self:CancelQueue(userId)
		table.insert(room.userIds, userId)
		room.seatByUserId[userId] = seatIndex
		room.readyByUserId[userId] = false
		self.privateRoomCodeByUserId[userId] = code
		log("[VRF] PRIVATE ROOM JOIN code=" .. code .. " seat=" .. tostring(seatIndex) .. " user=" .. userId)
		self:BroadcastPrivateRoomSnapshot(room)
		return { ok = true, reason = "", room = self:BuildPrivateRoomSnapshot(room, userId) }
	end

	@ExecSpace("ServerOnly")
	method boolean SetPrivateRoomReady(string userId, Entity playerEntity, boolean ready)
		local code = self.privateRoomCodeByUserId[userId]
		local room = code ~= nil and self.privateRoomByCode[code] or nil
		if room == nil then return false end
		local coordinator = self:GetTableCoordinator(room.tableId)
		if coordinator == nil or not coordinator:SetPrivateReady(userId, playerEntity, ready) then return false end
		room.readyByUserId[userId] = ready
		self:BroadcastPrivateRoomSnapshot(room)
		return true
	end

	method table BuildPrivateRoomSnapshot(table room, string viewerUserId)
		if room == nil then return nil end
		local members = {}
		for _, userId in ipairs(room.userIds) do
			local player = self.playerByUserId[userId]
			local nickname = "플레이어"
			if player ~= nil and isvalid(player) then
				if player.NameTagComponent ~= nil and player.NameTagComponent.Name ~= "" then nickname = player.NameTagComponent.Name end
			end
			table.insert(members, { userId = userId, nickname = nickname, seatIndex = room.seatByUserId[userId], ready = room.readyByUserId[userId] == true, owner = userId == room.ownerUserId })
		end
		return { code = room.code, title = room.title, capacity = room.capacity, hasPassword = room.password ~= "", ownerUserId = room.ownerUserId, viewerUserId = viewerUserId, members = members }
	end

	@ExecSpace("ServerOnly")
	method void BroadcastPrivateRoomSnapshot(table room)
		if room == nil then return end
		for _, userId in ipairs(room.userIds) do
			local playerEntity = self.playerByUserId[userId]
			local controls = playerEntity ~= nil and isvalid(playerEntity) and playerEntity:GetComponent("script.LexioManualTestControls") or nil
			if controls ~= nil then controls:ApplyPrivateRoomSnapshot(self:BuildPrivateRoomSnapshot(room, userId)) end
		end
	end

	method table ListPrivateRooms()
		local emptyRooms = {}
		for _, room in pairs(self.privateRoomByCode) do if #room.userIds == 0 then table.insert(emptyRooms, room) end end
		for _, room in ipairs(emptyRooms) do self:DestroyEmptyPrivateRoom(room) end
		local rooms = {}
		for _, room in pairs(self.privateRoomByCode) do
			local coordinator = self:GetTableCoordinator(room.tableId)
			local session = coordinator ~= nil and coordinator.SessionEntity:GetComponent("script.LexioGameSession") or nil
			local phase = session ~= nil and session.phase or "Unavailable"
			if coordinator ~= nil and coordinator.startCountdownActive then phase = "Countdown" end
			local canJoin = phase == "WaitingPlayers" and #room.userIds < room.capacity and coordinator ~= nil and not coordinator.startRequested
			table.insert(rooms, { code = room.code, title = room.title, capacity = room.capacity, playerCount = #room.userIds, hasPassword = room.password ~= "", phase = phase, canJoin = canJoin })
		end
		return rooms
	end

	@ExecSpace("ServerOnly")
	method boolean LeavePrivateRoom(string userId, string reason)
		local code = self.privateRoomCodeByUserId[userId]
		local room = code ~= nil and self.privateRoomByCode[code] or nil
		if room == nil then return true end
		if not self:ReleasePlayer(userId, reason) then return false end
		for index = #room.userIds, 1, -1 do if room.userIds[index] == userId then table.remove(room.userIds, index) end end
		room.readyByUserId[userId] = nil
		room.seatByUserId[userId] = nil
		self.privateRoomCodeByUserId[userId] = nil
		if #room.userIds == 0 then
			self:DestroyEmptyPrivateRoom(room)
		else
			if room.ownerUserId == userId then room.ownerUserId = room.userIds[1] end
			log("[VRF] PRIVATE ROOM LEAVE code=" .. code .. " user=" .. userId .. " remaining=" .. tostring(#room.userIds))
			self:BroadcastPrivateRoomSnapshot(room)
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean ReserveQueuedSeat(string userId, Entity playerEntity, string tableId, integer seatIndex)
		local chairName = self:GetSeatChairName(tableId, seatIndex)
		local seatKey = self:MakeSeatKey(tableId, seatIndex)
		if self.seatOwnerByKey[seatKey] ~= nil then return false end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil or not coordinator:RegisterTablePlayer(playerEntity, userId, tableId, seatIndex, chairName) then return false end
		self.seatOwnerByKey[seatKey] = userId
		self.seatByUserId[userId] = { key = seatKey, tableId = tableId, seatIndex = seatIndex, chairName = chairName }
		self.playerByUserId[userId] = playerEntity
		log("[VRF] MATCH ASSIGNED userId=" .. userId .. " table=" .. tableId .. " seat=" .. tostring(seatIndex))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean CanReserveQueuedSeat(string userId, Entity playerEntity, string tableId, integer seatIndex)
		if userId == nil or userId == "" or playerEntity == nil or not isvalid(playerEntity) then return false end
		if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return false end
		if not self:IsPlayerInGameRoom(playerEntity) then return false end
		if self.seatByUserId[userId] ~= nil or self.spectatorTableByUserId[userId] ~= nil then return false end
		local chairName = self:GetSeatChairName(tableId, seatIndex)
		if not self:IsValidTableSeat(tableId, seatIndex, chairName) then return false end
		if self.seatOwnerByKey[self:MakeSeatKey(tableId, seatIndex)] ~= nil then return false end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil then return false end
		local session = coordinator.SessionEntity:GetComponent("script.LexioGameSession")
		return session ~= nil and session.phase == "WaitingPlayers" and not coordinator.startRequested
	end

	@ExecSpace("ServerOnly")
	method void RestoreMatchToQueue(table matched, integer assignedCount, string reason)
		for index = assignedCount, 1, -1 do
			local entry = matched[index]
			self:ReleasePlayer(entry.userId, "auto_rollback")
		end
		for index = #matched, 1, -1 do
			local entry = matched[index]
			self.queuedByUserId[entry.userId] = nil
			if self:IsPlayerInGameRoom(entry.playerEntity) then
				self.queuedByUserId[entry.userId] = true
				self.queuePreferenceByUserId[entry.userId] = entry.preference or 0
				self.playerByUserId[entry.userId] = entry.playerEntity
				table.insert(self.queueUserIds, 1, entry.userId)
			end
		end
		self:BroadcastQueueStates()
		log("[VRF] MATCH ROLLBACK reason=" .. tostring(reason) .. " restored=" .. tostring(#matched))
	end

	@ExecSpace("ServerOnly")
	method void BroadcastQueueStates()
		for position, userId in ipairs(self.queueUserIds) do
			local playerEntity = self.playerByUserId[userId]
			local controls = playerEntity ~= nil and isvalid(playerEntity) and playerEntity:GetComponent("script.LexioManualTestControls") or nil
			if controls ~= nil then controls:ApplyQueueState(true, position, self.queuePreferenceByUserId[userId] or 0) end
		end
	end

	@ExecSpace("ServerOnly")
	method table BuildQueueCandidateIds(integer required)
		local candidateIds = {}
		-- Exact-size requests keep priority; Any only fills the remaining seats.
		for _, userId in ipairs(self.queueUserIds) do
			if (self.queuePreferenceByUserId[userId] or 0) == required then table.insert(candidateIds, userId) end
		end
		for _, userId in ipairs(self.queueUserIds) do
			if (self.queuePreferenceByUserId[userId] or 0) == 0 then table.insert(candidateIds, userId) end
		end
		return candidateIds
	end

	@ExecSpace("ServerOnly")
	method boolean TryMatchQueueFor(string tableId, integer required)
		if not self:IsTableEmpty(tableId) then return false end
		local matched = {}
		for _, userId in ipairs(self:BuildQueueCandidateIds(required)) do
			local preference = self.queuePreferenceByUserId[userId] or 0
			local playerEntity = self.playerByUserId[userId]
				if self:IsPlayerInGameRoom(playerEntity) then
					table.insert(matched, { userId = userId, playerEntity = playerEntity, seatIndex = #matched + 1, preference = preference })
					if #matched == required then break end
				end
		end
		if #matched < required then return false end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil or not coordinator:SetPersistentRewardsEligible(true, "automatic_match") then return false end
		local selected = {}
		for _, entry in ipairs(matched) do selected[entry.userId] = true end
		for index = #self.queueUserIds, 1, -1 do
			if selected[self.queueUserIds[index]] then table.remove(self.queueUserIds, index) end
		end
		for _, entry in ipairs(matched) do
			if not self:CanReserveQueuedSeat(entry.userId, entry.playerEntity, tableId, entry.seatIndex) then
				self:RestoreMatchToQueue(matched, 0, "preflight")
				return false
			end
		end
		local assignedCount = 0
		for _, entry in ipairs(matched) do
			self.queuedByUserId[entry.userId] = nil
			self.queuePreferenceByUserId[entry.userId] = nil
			if not self:ReserveQueuedSeat(entry.userId, entry.playerEntity, tableId, entry.seatIndex) then
				self:RestoreMatchToQueue(matched, assignedCount, "assignment_failed")
				return false
			end
			assignedCount = assignedCount + 1
		end
		for _, entry in ipairs(matched) do
			local seat = self.seatByUserId[entry.userId]
			local controls = entry.playerEntity:GetComponent("script.LexioManualTestControls")
			if controls ~= nil and seat ~= nil then controls:ApplyAutoMatchResult(true, seat.chairName, 0) end
		end
		self:BroadcastQueueStates()
		log("[VRF] MATCH COMPLETE table=" .. tableId .. " players=" .. tostring(#matched))
		return true
	end

	@ExecSpace("ServerOnly")
	method void TryMatchQueue()
		self:FillExistingPublicRooms()
		for required = 3, 5 do
			while #self:BuildQueueCandidateIds(required) >= required do
				local tableId = self:GetTableIdForCapacity(required)
				if tableId == "" or not self:TryMatchQueueFor(tableId, required) then break end
			end
		end
		self:CleanupIdleDynamicSessions()
	end

	@ExecSpace("ServerOnly")
	method boolean JoinQueue(string userId, Entity playerEntity, integer required)
		if userId == nil or userId == "" or playerEntity == nil or not isvalid(playerEntity) then return false end
		if required ~= 0 and required ~= 3 and required ~= 4 and required ~= 5 then return false end
		if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return false end
		if not self:IsPlayerInGameRoom(playerEntity) then return false end
		if self.seatByUserId[userId] ~= nil or self.spectatorTableByUserId[userId] ~= nil then return false end
		if self.queuedByUserId[userId] then
			self:BroadcastQueueStates()
			return true
		end
		self.queuedByUserId[userId] = true
		self.queuePreferenceByUserId[userId] = required
		self.playerByUserId[userId] = playerEntity
		table.insert(self.queueUserIds, userId)
		self:BroadcastQueueStates()
		log("[VRF] QUEUE JOIN userId=" .. userId .. " required=" .. tostring(required) .. " position=" .. tostring(#self.queueUserIds))
		self:TryMatchQueue()
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean CancelQueue(string userId)
		if not self.queuedByUserId[userId] then return true end
		self.queuedByUserId[userId] = nil
		self.queuePreferenceByUserId[userId] = nil
		for index = #self.queueUserIds, 1, -1 do
			if self.queueUserIds[index] == userId then table.remove(self.queueUserIds, index) end
		end
		if self.seatByUserId[userId] == nil then self.playerByUserId[userId] = nil end
		self:BroadcastQueueStates()
		log("[VRF] QUEUE CANCEL userId=" .. userId)
		return true
	end

	method integer GetRequiredPlayerCount(string tableId)
		if self._T.DynamicCapacities ~= nil and self._T.DynamicCapacities[tableId] ~= nil then return self._T.DynamicCapacities[tableId] end
		if tableId == "table01" then return 3 end
		if tableId == "table02" then return 4 end
		if tableId == "table03" then return 5 end
		return 0
	end

	method boolean IsValidTableSeat(string tableId, integer seatIndex, string chairName)
		local required = self:GetRequiredPlayerCount(tableId)
		return required >= 3 and seatIndex >= 1 and seatIndex <= required and chairName == self:GetSeatChairName(tableId, seatIndex)
	end

	method string MakeSeatKey(string tableId, integer seatIndex)
		return tableId .. ":" .. tostring(seatIndex)
	end

	method string GetSessionHostPath(string tableId)
		if tableId == "table01" then return "/maps/map01/LexioTable01SessionHost" end
		if tableId == "table02" then return "/maps/map01/LexioTable02SessionHost" end
		if tableId == "table03" then return "/maps/map01/LexioTable03SessionHost" end
		return ""
	end

	@ExecSpace("ServerOnly")
	method any GetTableCoordinator(string tableId)
		local dynamic = self._T.DynamicHosts ~= nil and self._T.DynamicHosts[tableId] or nil
		if dynamic ~= nil then
			if not isvalid(dynamic) then return nil end
			return dynamic:GetComponent("script.LexioSessionCoordinator")
		end
		local path = self:GetSessionHostPath(tableId)
		if path == "" then return nil end
		local host = _EntityService:GetEntityByPath(path)
		if host == nil or not isvalid(host) then return nil end
		return host:GetComponent("script.LexioSessionCoordinator")
	end

	@ExecSpace("ServerOnly")
	method boolean TryReserveSeat(string userId, Entity playerEntity, string tableId, integer seatIndex, string chairName)
		if userId == nil or userId == "" or playerEntity == nil or not isvalid(playerEntity) then return false end
		if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return false end
		if not self:IsPlayerInGameRoom(playerEntity) then return false end
		self:CancelQueue(userId)
		self:SetSpectatorTable(userId, playerEntity, "")
		if not self:IsValidTableSeat(tableId, seatIndex, chairName) then
			log("[LexioTableRegistry] REJECT reason=invalid_seat userId=" .. userId)
			return false
		end
		local chair = _EntityService:GetEntityByPath("/maps/map01/" .. chairName)
		if chair == nil or not isvalid(chair) then return false end
		local playerPosition = playerEntity.TransformComponent.WorldPosition
		local chairPosition = chair.TransformComponent.WorldPosition
		local distance = Vector2.Distance(Vector2(playerPosition.x, playerPosition.y), Vector2(chairPosition.x, chairPosition.y))
		if distance > 1.2 then
			log("[LexioTableRegistry] REJECT reason=too_far userId=" .. userId .. " distance=" .. tostring(distance))
			return false
		end
		local existing = self.seatByUserId[userId]
		local seatKey = self:MakeSeatKey(tableId, seatIndex)
		if existing ~= nil and existing.key ~= seatKey then
			log("[LexioTableRegistry] REJECT reason=already_seated userId=" .. userId)
			return false
		end
		local owner = self.seatOwnerByKey[seatKey]
		if owner ~= nil and owner ~= userId then
			log("[LexioTableRegistry] REJECT reason=occupied key=" .. seatKey)
			return false
		end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil then
			log("[LexioTableRegistry] REJECT reason=missing_coordinator table=" .. tableId)
			return false
		end
		if not coordinator:RegisterTablePlayer(playerEntity, userId, tableId, seatIndex, chairName) then
			log("[LexioTableRegistry] REJECT reason=session_rejected table=" .. tableId .. " userId=" .. userId)
			return false
		end
		self.seatOwnerByKey[seatKey] = userId
		self.seatByUserId[userId] = { key = seatKey, tableId = tableId, seatIndex = seatIndex, chairName = chairName }
		self.playerByUserId[userId] = playerEntity
		log("[LexioTableRegistry] RESERVED userId=" .. userId .. " table=" .. tableId .. " seat=" .. tostring(seatIndex))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean ReleasePlayer(string userId, string reason)
		local seat = self.seatByUserId[userId]
		if seat == nil then return true end
		local playerEntity = self.playerByUserId[userId]
		local coordinator = self:GetTableCoordinator(seat.tableId)
		if coordinator ~= nil and not coordinator:ReleaseTablePlayer(userId, playerEntity, seat.tableId) then
			log("[LexioTableRegistry] RELEASE REJECTED userId=" .. userId .. " table=" .. seat.tableId .. " reason=" .. tostring(reason))
			return false
		end
		if self.seatOwnerByKey[seat.key] == userId then self.seatOwnerByKey[seat.key] = nil end
		self.seatByUserId[userId] = nil
		self.playerByUserId[userId] = nil
		log("[LexioTableRegistry] RELEASED userId=" .. userId .. " table=" .. seat.tableId .. " seat=" .. tostring(seat.seatIndex) .. " reason=" .. tostring(reason))
		return true
	end

	method table FindPlayerSeat(string userId)
		return self.seatByUserId[userId]
	end

	method table GetTablePlayers(string tableId)
		local players = {}
		local requiredPlayerCount = self:GetRequiredPlayerCount(tableId)
		for seatIndex = 1, requiredPlayerCount do
			local userId = self.seatOwnerByKey[self:MakeSeatKey(tableId, seatIndex)]
			if userId ~= nil then table.insert(players, { userId = userId, playerEntity = self.playerByUserId[userId], seatIndex = seatIndex }) end
		end
		return players
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		self:CancelQueue(event.UserId)
		local activeSeat = self.seatByUserId[event.UserId]
		local activeCoordinator = activeSeat ~= nil and self:GetTableCoordinator(activeSeat.tableId) or nil
		local activeSession = activeCoordinator ~= nil and activeCoordinator.SessionEntity:GetComponent("script.LexioGameSession") or nil
		if activeSession ~= nil and (activeSession.phase == "Playing" or activeSession.phase == "LeadPending") then
			activeCoordinator:MarkDisconnected(event.UserId)
			return
		end
		local spectatorTable = self.spectatorTableByUserId[event.UserId]
		if spectatorTable ~= nil then
			local coordinator = self:GetTableCoordinator(spectatorTable)
			if coordinator ~= nil then coordinator:ReleaseTableSpectator(event.UserId) end
			self.spectatorTableByUserId[event.UserId] = nil
		end
		if self.privateRoomCodeByUserId[event.UserId] ~= nil then self:LeavePrivateRoom(event.UserId, "user_leave")
		else self:ReleasePlayer(event.UserId, "user_leave") end
	end


	@ExecSpace("ServerOnly")
	method boolean DestroyEmptyPrivateRoom(table room)
		if room == nil or #room.userIds ~= 0 then return false end
		-- Retained reconnect seats still count as participants; never remove an occupied table.
		for _, seat in pairs(self.seatByUserId) do if seat.tableId == room.tableId then return false end end
		local coordinator = self:GetTableCoordinator(room.tableId)
		if coordinator ~= nil and coordinator.privateRoomCode == room.code then coordinator:ResetEmptyTable() end
		for seat = 1, room.capacity do self.seatOwnerByKey[self:MakeSeatKey(room.tableId, seat)] = nil end
		self.privateRoomByCode[room.code] = nil
		if self.privateRoomCodeByTableId[room.tableId] == room.code then self.privateRoomCodeByTableId[room.tableId] = nil end
		log("[VRF] PRIVATE ROOM DESTROYED empty=true code=" .. room.code)
		return true
	end


	@ExecSpace("ServerOnly")
	method table UpdatePrivateRoomSettings(string userId, Entity playerEntity, integer capacity, boolean usePassword, string password)
		local code = self.privateRoomCodeByUserId[userId]
		local room = code ~= nil and self.privateRoomByCode[code] or nil
		if room == nil then return { ok = false, reason = "room_not_found" } end
		if room.ownerUserId ~= userId or self.playerByUserId[userId] ~= playerEntity or playerEntity == nil or not isvalid(playerEntity) or playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return { ok = false, reason = "not_owner" } end
		local source = self:GetTableCoordinator(room.tableId)
		local session = source ~= nil and source.SessionEntity:GetComponent("script.LexioGameSession") or nil
		if session == nil or session.phase ~= "WaitingPlayers" or source.startRequested then return { ok = false, reason = "room_in_progress" } end
		local targetId = capacity == room.capacity and room.tableId or self:GetTableIdForCapacity(capacity)
		if targetId == "" then return { ok = false, reason = "invalid_capacity" } end
		if capacity < #room.userIds then return { ok = false, reason = "capacity_too_small" } end
		if password == nil or #password > 8 then return { ok = false, reason = "invalid_password" } end
		local nextPassword = usePassword and (password ~= "" and password or room.password) or ""
		if usePassword and nextPassword == "" then return { ok = false, reason = "password_required" } end
		if targetId ~= room.tableId then
			if not self:IsTableEmpty(targetId) then return { ok = false, reason = "capacity_busy" } end
			local target = self:GetTableCoordinator(targetId)
			if target == nil then return { ok = false, reason = "missing_coordinator" } end
			local players = {}
			local oldSeats = {}
			for _, id in ipairs(room.userIds) do
				local player = self.playerByUserId[id]
				local seat = self.seatByUserId[id]
				if player == nil or not isvalid(player) or player.CurrentMap ~= playerEntity.CurrentMap or seat == nil or seat.tableId ~= room.tableId or source.playerEntityBySeat[seat.seatIndex] ~= player then return { ok = false, reason = "participant_unavailable" } end
				players[id] = player
				oldSeats[id] = seat.seatIndex
			end
			local oldTableId = room.tableId
			source:CancelStartCountdown("room_settings")
			for _, id in ipairs(room.userIds) do self:ReleasePlayer(id, "room_settings") end
			local activated = target:ActivatePrivateRoom(code)
			local reserved = activated
			if activated then
				for index, id in ipairs(room.userIds) do
					if not self:ReserveQueuedSeat(id, players[id], targetId, index) then reserved = false break end
				end
			end
			if not reserved then
				for _, id in ipairs(room.userIds) do
					local seat = self.seatByUserId[id]
					if seat ~= nil and seat.tableId == targetId then self:ReleasePlayer(id, "settings_rollback") end
				end
				if activated then target:ResetEmptyTable() end
				for _, id in ipairs(room.userIds) do
					self:ReserveQueuedSeat(id, players[id], oldTableId, oldSeats[id])
					source.explicitReadyBySeat[oldSeats[id]] = false
					room.readyByUserId[id] = false
				end
				self:BroadcastPrivateRoomSnapshot(room)
				return { ok = false, reason = "settings_failed" }
			end
			source:ResetEmptyTable()
			self.privateRoomCodeByTableId[oldTableId] = nil
			self.privateRoomCodeByTableId[targetId] = code
			room.tableId = targetId
			for index, id in ipairs(room.userIds) do room.seatByUserId[id] = index end
		end
		room.capacity = capacity
		room.password = nextPassword
		local coordinator = self:GetTableCoordinator(room.tableId)
		coordinator:CancelStartCountdown("room_settings")
		for _, id in ipairs(room.userIds) do
			room.readyByUserId[id] = false
			coordinator.explicitReadyBySeat[room.seatByUserId[id]] = false
		end
		self:BroadcastPrivateRoomSnapshot(room)
		coordinator:BroadcastSnapshots()
		log("[VRF] ROOM SETTINGS changed code=" .. code .. " capacity=" .. tostring(capacity) .. " locked=" .. tostring(usePassword))
		return { ok = true, reason = "" }
	end


	@ExecSpace("ServerOnly")
	method string GetSeatChairName(string tableId, integer seatIndex)
		if self._T.DynamicCapacities ~= nil and self._T.DynamicCapacities[tableId] ~= nil then return "LexioSession_" .. tableId .. "_Seat" .. tostring(seatIndex) end
		return "LexioTable" .. string.sub(tableId, 6, 7) .. "Chair" .. tostring(seatIndex)
	end

	@ExecSpace("ServerOnly")
	method string CreateDynamicSession(integer capacity)
		if capacity ~= 3 and capacity ~= 4 and capacity ~= 5 then return "" end
		self._T.DynamicHosts = self._T.DynamicHosts or {}
		self._T.DynamicCapacities = self._T.DynamicCapacities or {}
		self._T.DynamicSequence = (self._T.DynamicSequence or 0) + 1
		local tableId = "session" .. tostring(self._T.DynamicSequence)
		local map = self.Entity.CurrentMap
		if map == nil then return "" end
		local host = _SpawnService:SpawnByModelId("bd6d7b90-2c4e-4dc1-b076-3a1420f52f48", "LexioSession_" .. tableId, Vector3(0, 0, 0), map)
		if host == nil or not isvalid(host) then return "" end
		local coordinator = host:GetComponent("script.LexioSessionCoordinator")
		local session = host:GetComponent("script.LexioGameSession")
		if coordinator == nil or session == nil then _EntityService:Destroy(host) return "" end
		-- Explicit initialization is idempotent when the engine delivers OnBeginPlay later.
		coordinator:OnBeginPlay()
		coordinator.TableId = tableId
		coordinator.RequiredPlayerCount = capacity
		coordinator.SessionEntity = host
		coordinator:ResetEmptyTable()
		self._T.DynamicHosts[tableId] = host
		self._T.DynamicCapacities[tableId] = capacity
		log("[VRF] ROOM SESSION created table=" .. tableId .. " capacity=" .. tostring(capacity))
		return tableId
	end

	@ExecSpace("ServerOnly")
	method void CleanupIdleDynamicSessions()
		local idle = {}
		for tableId, host in pairs(self._T.DynamicHosts or {}) do
			if self:IsTableEmpty(tableId) then table.insert(idle, tableId) end
		end
		for _, tableId in ipairs(idle) do
			local host = self._T.DynamicHosts[tableId]
			self._T.DynamicHosts[tableId] = nil
			self._T.DynamicCapacities[tableId] = nil
			if host ~= nil and isvalid(host) then _EntityService:Destroy(host) end
			log("[VRF] ROOM SESSION destroyed table=" .. tableId)
		end
	end


	@ExecSpace("ServerOnly")
	method void FillExistingPublicRooms()
		local available = {}
		for _, room in pairs(self.privateRoomByCode) do
			local coordinator = self:GetTableCoordinator(room.tableId)
			local session = coordinator ~= nil and coordinator.SessionEntity:GetComponent("script.LexioGameSession") or nil
			if room.password == "" and #room.userIds > 0 and #room.userIds < room.capacity and session ~= nil and session.phase == "WaitingPlayers" and not coordinator.startRequested and not coordinator.startCountdownActive then
				table.insert(available, room)
			end
		end
		-- Fill nearly-complete rooms first; older room codes break ties deterministically.
		table.sort(available, function(left, right)
			local leftFree = left.capacity - #left.userIds
			local rightFree = right.capacity - #right.userIds
			if leftFree ~= rightFree then return leftFree < rightFree end
			return left.code < right.code
		end)
		for _, room in ipairs(available) do
			while #room.userIds < room.capacity do
				local chosen = nil
				local player = nil
				for _, userId in ipairs(self:BuildQueueCandidateIds(room.capacity)) do
					local candidate = self.playerByUserId[userId]
					if self:IsPlayerInGameRoom(candidate) then
						chosen = userId
						player = candidate
						break
					else self:CancelQueue(userId) end
				end
				if chosen == nil then break end
				local result = self:JoinPrivateRoom(chosen, player, room.code, "")
				if not result.ok then break end
				local seat = self.seatByUserId[chosen]
				local controls = player:GetComponent("script.LexioManualTestControls")
				if controls ~= nil and seat ~= nil then controls:ApplyAutoMatchResult(true, seat.chairName, 0, chosen) end
				log("[VRF] QUICK MATCH existing_room=" .. room.code .. " user=" .. chosen)
			end
		end
	end

end
