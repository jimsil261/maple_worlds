@Component
script LexioTableRegistry extends Component

	property table seatOwnerByKey = {}

	property table seatByUserId = {}

	property table playerByUserId = {}

	property table queueUserIds = {}

	property table queuedByUserId = {}

	property table spectatorTableByUserId = {}

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.seatOwnerByKey = {}
		self.seatByUserId = {}
		self.playerByUserId = {}
		self.queueUserIds = {}
		self.queuedByUserId = {}
		self.spectatorTableByUserId = {}
		log("[LexioTableRegistry] READY tables=3 seats=12")
	end

	@ExecSpace("ServerOnly")
	method boolean SetSpectatorTable(string userId, Entity playerEntity, string tableId)
		if userId == nil or userId == "" or playerEntity == nil or not isvalid(playerEntity) then return false end
		if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return false end
		if playerEntity.CurrentMap ~= self.Entity.CurrentMap or playerEntity.CurrentMapName ~= "map01" then return false end
		if self.seatByUserId[userId] ~= nil or self.queuedByUserId[userId] then return false end
		local previous = self.spectatorTableByUserId[userId]
		if previous ~= nil then
			local previousCoordinator = self:GetTableCoordinator(previous)
			if previousCoordinator ~= nil then previousCoordinator:ReleaseTableSpectator(userId) end
			self.spectatorTableByUserId[userId] = nil
		end
		if tableId == "" then
			local lobbyCoordinator = self.Entity:GetComponent("script.LexioSessionCoordinator")
			if lobbyCoordinator ~= nil then lobbyCoordinator:AttachBridge(playerEntity, userId, 0, "Spectator") end
			return true
		end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil or not coordinator:RegisterTableSpectator(playerEntity, userId, tableId) then return false end
		self.spectatorTableByUserId[userId] = tableId
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean IsTableEmpty(string tableId)
		for seatIndex = 1, self:GetRequiredPlayerCount(tableId) do
			if self.seatOwnerByKey[self:MakeSeatKey(tableId, seatIndex)] ~= nil then return false end
		end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil then return false end
		local session = coordinator.SessionEntity:GetComponent("script.LexioGameSession")
		return session ~= nil and session.phase == "WaitingPlayers" and not coordinator.startRequested
	end

	@ExecSpace("ServerOnly")
	method boolean ReserveQueuedSeat(string userId, Entity playerEntity, string tableId, integer seatIndex)
		local tableNumber = string.sub(tableId, 6, 7)
		local chairName = "LexioTable" .. tableNumber .. "Chair" .. tostring(seatIndex)
		local seatKey = self:MakeSeatKey(tableId, seatIndex)
		if self.seatOwnerByKey[seatKey] ~= nil then return false end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil or not coordinator:RegisterTablePlayer(playerEntity, userId, tableId, seatIndex, chairName) then return false end
		self.seatOwnerByKey[seatKey] = userId
		self.seatByUserId[userId] = { key = seatKey, tableId = tableId, seatIndex = seatIndex, chairName = chairName }
		self.playerByUserId[userId] = playerEntity
		log("[VRF] MATCH ASSIGNED userId=" .. userId .. " table=" .. tableId .. " seat=" .. tostring(seatIndex))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean CanReserveQueuedSeat(string userId, Entity playerEntity, string tableId, integer seatIndex)
		if userId == nil or userId == "" or playerEntity == nil or not isvalid(playerEntity) then return false end
		if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return false end
		if playerEntity.CurrentMap ~= self.Entity.CurrentMap or playerEntity.CurrentMapName ~= "map01" then return false end
		if self.seatByUserId[userId] ~= nil or self.spectatorTableByUserId[userId] ~= nil then return false end
		local chairName = "LexioTable" .. string.sub(tableId, 6, 7) .. "Chair" .. tostring(seatIndex)
		if not self:IsValidTableSeat(tableId, seatIndex, chairName) then return false end
		if self.seatOwnerByKey[self:MakeSeatKey(tableId, seatIndex)] ~= nil then return false end
		local chair = _EntityService:GetEntityByPath("/maps/map01/" .. chairName)
		local coordinator = self:GetTableCoordinator(tableId)
		if chair == nil or not isvalid(chair) or coordinator == nil then return false end
		local session = coordinator.SessionEntity:GetComponent("script.LexioGameSession")
		return session ~= nil and session.phase == "WaitingPlayers" and not coordinator.startRequested
	end

	@ExecSpace("ServerOnly")
	method void RestoreMatchToQueue(table matched, integer assignedCount, string reason)
		for index = assignedCount, 1, -1 do
			local entry = matched[index]
			self:ReleasePlayer(entry.userId, "auto_rollback")
		end
		for index = #matched, 1, -1 do
			local entry = matched[index]
			self.queuedByUserId[entry.userId] = nil
			if entry.playerEntity ~= nil and isvalid(entry.playerEntity) and entry.playerEntity.CurrentMapName == "map01" then
				self.queuedByUserId[entry.userId] = true
				self.playerByUserId[entry.userId] = entry.playerEntity
				table.insert(self.queueUserIds, 1, entry.userId)
			end
		end
		self:BroadcastQueueStates()
		log("[VRF] MATCH ROLLBACK reason=" .. tostring(reason) .. " restored=" .. tostring(#matched))
	end

	@ExecSpace("ServerOnly")
	method void BroadcastQueueStates()
		for position, userId in ipairs(self.queueUserIds) do
			local playerEntity = self.playerByUserId[userId]
			local controls = playerEntity ~= nil and isvalid(playerEntity) and playerEntity:GetComponent("script.LexioManualTestControls") or nil
			if controls ~= nil then controls:ApplyQueueState(true, position, 3) end
		end
	end

	@ExecSpace("ServerOnly")
	method void TryMatchQueue()
		local required = self:GetRequiredPlayerCount("table01")
		if #self.queueUserIds < required or not self:IsTableEmpty("table01") then return end
		local matched = {}
		for seatIndex = 1, required do
			local userId = table.remove(self.queueUserIds, 1)
			local playerEntity = self.playerByUserId[userId]
			if userId == nil or playerEntity == nil or not isvalid(playerEntity) or playerEntity.CurrentMapName ~= "map01" then
				if userId ~= nil then self.queuedByUserId[userId] = nil end
				self:TryMatchQueue()
				return
			end
			table.insert(matched, { userId = userId, playerEntity = playerEntity, seatIndex = seatIndex })
		end
		for _, entry in ipairs(matched) do
			if not self:CanReserveQueuedSeat(entry.userId, entry.playerEntity, "table01", entry.seatIndex) then
				self:RestoreMatchToQueue(matched, 0, "preflight")
				return
			end
		end
		local assignedCount = 0
		for _, entry in ipairs(matched) do
			self.queuedByUserId[entry.userId] = nil
			if not self:ReserveQueuedSeat(entry.userId, entry.playerEntity, "table01", entry.seatIndex) then
				self:RestoreMatchToQueue(matched, assignedCount, "assignment_failed")
				return
			end
			assignedCount = assignedCount + 1
		end
		for _, entry in ipairs(matched) do
			local seat = self.seatByUserId[entry.userId]
			local controls = entry.playerEntity:GetComponent("script.LexioManualTestControls")
			if controls ~= nil and seat ~= nil then controls:ApplyAutoMatchResult(true, seat.chairName, 0) end
		end
		self:BroadcastQueueStates()
		log("[VRF] MATCH COMPLETE table=table01 players=" .. tostring(#matched))
	end

	@ExecSpace("ServerOnly")
	method boolean JoinQueue(string userId, Entity playerEntity)
		if userId == nil or userId == "" or playerEntity == nil or not isvalid(playerEntity) then return false end
		if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return false end
		if playerEntity.CurrentMap ~= self.Entity.CurrentMap or playerEntity.CurrentMapName ~= "map01" then return false end
		if self.seatByUserId[userId] ~= nil or self.spectatorTableByUserId[userId] ~= nil then return false end
		if self.queuedByUserId[userId] then
			self:BroadcastQueueStates()
			return true
		end
		self.queuedByUserId[userId] = true
		self.playerByUserId[userId] = playerEntity
		table.insert(self.queueUserIds, userId)
		self:BroadcastQueueStates()
		log("[VRF] QUEUE JOIN userId=" .. userId .. " position=" .. tostring(#self.queueUserIds))
		self:TryMatchQueue()
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean CancelQueue(string userId)
		if not self.queuedByUserId[userId] then return true end
		self.queuedByUserId[userId] = nil
		for index = #self.queueUserIds, 1, -1 do
			if self.queueUserIds[index] == userId then table.remove(self.queueUserIds, index) end
		end
		if self.seatByUserId[userId] == nil then self.playerByUserId[userId] = nil end
		self:BroadcastQueueStates()
		log("[VRF] QUEUE CANCEL userId=" .. userId)
		return true
	end

	method integer GetRequiredPlayerCount(string tableId)
		if tableId == "table01" then return 3 end
		if tableId == "table02" then return 4 end
		if tableId == "table03" then return 5 end
		return 0
	end

	method boolean IsValidTableSeat(string tableId, integer seatIndex, string chairName)
		local requiredPlayerCount = self:GetRequiredPlayerCount(tableId)
		if requiredPlayerCount == 0 then return false end
		if seatIndex < 1 or seatIndex > requiredPlayerCount then return false end
		local tableNumber = string.sub(tableId, 6, 7)
		return chairName == "LexioTable" .. tableNumber .. "Chair" .. tostring(seatIndex)
	end

	method string MakeSeatKey(string tableId, integer seatIndex)
		return tableId .. ":" .. tostring(seatIndex)
	end

	method string GetSessionHostPath(string tableId)
		if tableId == "table01" then return "/maps/map01/LexioTable01SessionHost" end
		if tableId == "table02" then return "/maps/map01/LexioTable02SessionHost" end
		if tableId == "table03" then return "/maps/map01/LexioTable03SessionHost" end
		return ""
	end

	@ExecSpace("ServerOnly")
	method any GetTableCoordinator(string tableId)
		local path = self:GetSessionHostPath(tableId)
		if path == "" then return nil end
		local host = _EntityService:GetEntityByPath(path)
		if host == nil or not isvalid(host) then return nil end
		return host:GetComponent("script.LexioSessionCoordinator")
	end

	@ExecSpace("ServerOnly")
	method boolean TryReserveSeat(string userId, Entity playerEntity, string tableId, integer seatIndex, string chairName)
		if userId == nil or userId == "" or playerEntity == nil or not isvalid(playerEntity) then return false end
		if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return false end
		if playerEntity.CurrentMap ~= self.Entity.CurrentMap or playerEntity.CurrentMapName ~= "map01" then return false end
		self:CancelQueue(userId)
		self:SetSpectatorTable(userId, playerEntity, "")
		if not self:IsValidTableSeat(tableId, seatIndex, chairName) then
			log("[LexioTableRegistry] REJECT reason=invalid_seat userId=" .. userId)
			return false
		end
		local chair = _EntityService:GetEntityByPath("/maps/map01/" .. chairName)
		if chair == nil or not isvalid(chair) then return false end
		local playerPosition = playerEntity.TransformComponent.WorldPosition
		local chairPosition = chair.TransformComponent.WorldPosition
		local distance = Vector2.Distance(Vector2(playerPosition.x, playerPosition.y), Vector2(chairPosition.x, chairPosition.y))
		if distance > 1.2 then
			log("[LexioTableRegistry] REJECT reason=too_far userId=" .. userId .. " distance=" .. tostring(distance))
			return false
		end
		local existing = self.seatByUserId[userId]
		local seatKey = self:MakeSeatKey(tableId, seatIndex)
		if existing ~= nil and existing.key ~= seatKey then
			log("[LexioTableRegistry] REJECT reason=already_seated userId=" .. userId)
			return false
		end
		local owner = self.seatOwnerByKey[seatKey]
		if owner ~= nil and owner ~= userId then
			log("[LexioTableRegistry] REJECT reason=occupied key=" .. seatKey)
			return false
		end
		local coordinator = self:GetTableCoordinator(tableId)
		if coordinator == nil then
			log("[LexioTableRegistry] REJECT reason=missing_coordinator table=" .. tableId)
			return false
		end
		if not coordinator:RegisterTablePlayer(playerEntity, userId, tableId, seatIndex, chairName) then
			log("[LexioTableRegistry] REJECT reason=session_rejected table=" .. tableId .. " userId=" .. userId)
			return false
		end
		self.seatOwnerByKey[seatKey] = userId
		self.seatByUserId[userId] = { key = seatKey, tableId = tableId, seatIndex = seatIndex, chairName = chairName }
		self.playerByUserId[userId] = playerEntity
		log("[LexioTableRegistry] RESERVED userId=" .. userId .. " table=" .. tableId .. " seat=" .. tostring(seatIndex))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean ReleasePlayer(string userId, string reason)
		local seat = self.seatByUserId[userId]
		if seat == nil then return true end
		local playerEntity = self.playerByUserId[userId]
		local coordinator = self:GetTableCoordinator(seat.tableId)
		if coordinator ~= nil and not coordinator:ReleaseTablePlayer(userId, playerEntity, seat.tableId) then
			log("[LexioTableRegistry] RELEASE REJECTED userId=" .. userId .. " table=" .. seat.tableId .. " reason=" .. tostring(reason))
			return false
		end
		if self.seatOwnerByKey[seat.key] == userId then self.seatOwnerByKey[seat.key] = nil end
		self.seatByUserId[userId] = nil
		self.playerByUserId[userId] = nil
		log("[LexioTableRegistry] RELEASED userId=" .. userId .. " table=" .. seat.tableId .. " seat=" .. tostring(seat.seatIndex) .. " reason=" .. tostring(reason))
		return true
	end

	method table FindPlayerSeat(string userId)
		return self.seatByUserId[userId]
	end

	method table GetTablePlayers(string tableId)
		local players = {}
		local requiredPlayerCount = self:GetRequiredPlayerCount(tableId)
		for seatIndex = 1, requiredPlayerCount do
			local userId = self.seatOwnerByKey[self:MakeSeatKey(tableId, seatIndex)]
			if userId ~= nil then table.insert(players, { userId = userId, playerEntity = self.playerByUserId[userId], seatIndex = seatIndex }) end
		end
		return players
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		self:CancelQueue(event.UserId)
		local spectatorTable = self.spectatorTableByUserId[event.UserId]
		if spectatorTable ~= nil then
			local coordinator = self:GetTableCoordinator(spectatorTable)
			if coordinator ~= nil then coordinator:ReleaseTableSpectator(event.UserId) end
			self.spectatorTableByUserId[event.UserId] = nil
		end
		self:ReleasePlayer(event.UserId, "user_leave")
	end

end
