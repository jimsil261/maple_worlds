@Logic
script LexioPortalInputController extends Logic

	@ExecSpace("Server")
	method void RequestEntranceTravel(Entity claimedPlayer)
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if player == nil or player ~= claimedPlayer or player.PlayerComponent == nil then return end
		        if player.PlayerComponent.UserId ~= senderUserId then return end
		        local portalPath = ""
		        local destinationMap = ""
		        if player.CurrentMapName == "TileMapTemplate" then
		            portalPath = "/maps/TileMapTemplate/CafeEntrance"
		            destinationMap = "boardgame_cafe"
		        elseif player.CurrentMapName == "boardgame_cafe" then
		            portalPath = "/maps/boardgame_cafe/LexioEntrance"
		            destinationMap = "map01"
		        else
		            return
		        end
		        local portal = _EntityService:GetEntityByPath(portalPath)
		        if portal == nil or not isvalid(portal) then return end
		        local playerPosition = player.TransformComponent.WorldPosition
		        local portalPosition = portal.TransformComponent.WorldPosition
		        local distance = Vector2.Distance(Vector2(playerPosition.x, playerPosition.y), Vector2(portalPosition.x, portalPosition.y))
		        if distance > 0.9 then return end
		        local destinationPosition = Vector3(0, 0, 0)
		        if destinationMap == "map01" then destinationPosition = Vector3(-5.2, -12.0, 0) end
		        log("[LexioPortalInput] SERVER ENTER userId=" .. senderUserId .. " destination=" .. destinationMap)
		        player.PlayerComponent:MoveToMapPosition(destinationMap, Vector2(destinationPosition.x, destinationPosition.y))
	end

	@ExecSpace("Server")
	method void RequestFloorTravel(Entity claimedPlayer, string portalName)
		        local player = _UserService:GetUserEntityByUserId(senderUserId)
		        if player == nil or player ~= claimedPlayer or player.PlayerComponent == nil then return end
		        if player.PlayerComponent.UserId ~= senderUserId or player.CurrentMapName ~= "map01" then return end
		        local portal = _EntityService:GetEntityByPath("/maps/map01/" .. portalName)
		        if portal == nil or not isvalid(portal) then return end
		        local playerPosition = player.TransformComponent.WorldPosition
		        local portalPosition = portal.TransformComponent.WorldPosition
		        local distance = Vector2.Distance(Vector2(playerPosition.x, playerPosition.y), Vector2(portalPosition.x, portalPosition.y))
		        if distance > 0.9 then return end
		        local destinationPosition = Vector3(0, 0, 0)
		        if portalName == "Floor1UpPortal" then destinationPosition = Vector3(-5.2, -6.0, 0)
		        elseif portalName == "Floor2DownPortal" then destinationPosition = Vector3(5.2, -12.0, 0)
		        elseif portalName == "Floor2UpPortal" then destinationPosition = Vector3(-5.2, 0.5, 0)
		        elseif portalName == "Floor3DownPortal" then destinationPosition = Vector3(5.2, -6.0, 0)
		        else return end
		        log("[LexioPortalInput] FLOOR userId=" .. senderUserId .. " portal=" .. portalName)
		        player.PlayerComponent:MoveToMapPosition("map01", Vector2(destinationPosition.x, destinationPosition.y))
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandlePortalKeyDown(KeyDownEvent event)
		        if event.key ~= KeyboardKey.UpArrow then return end
		        local player = _UserService.LocalPlayer
		        if player == nil then return end
		        local portal = nil
		        if player.CurrentMapName == "TileMapTemplate" then
		            portal = _EntityService:GetEntityByPath("/maps/TileMapTemplate/CafeEntrance")
		        elseif player.CurrentMapName == "boardgame_cafe" then
		            portal = _EntityService:GetEntityByPath("/maps/boardgame_cafe/LexioEntrance")
		        elseif player.CurrentMapName == "map01" then
		            local portalNames = {"Floor1UpPortal", "Floor2DownPortal", "Floor2UpPortal", "Floor3DownPortal"}
		            local playerPosition = player.TransformComponent.WorldPosition
		            local nearestPortal = nil
		            local nearestDistance = 999
		            for _, portalName in ipairs(portalNames) do
		                local candidate = _EntityService:GetEntityByPath("/maps/map01/" .. portalName)
		                if candidate ~= nil then
		                    local candidatePosition = candidate.TransformComponent.WorldPosition
		                    local candidateDistance = Vector2.Distance(Vector2(playerPosition.x, playerPosition.y), Vector2(candidatePosition.x, candidatePosition.y))
		                    if candidateDistance < nearestDistance then nearestPortal = candidate; nearestDistance = candidateDistance end
		                end
		            end
		            if nearestPortal == nil or nearestDistance > 0.9 then return end
		            log("[LexioPortalInput] UP floor_portal=" .. nearestPortal.Name .. " distance=" .. tostring(nearestDistance))
		            self:RequestFloorTravel(player, nearestPortal.Name)
		            return
		        else
		            return
		        end
		        if portal == nil then return end
		        local playerPosition = player.TransformComponent.WorldPosition
		        local portalPosition = portal.TransformComponent.WorldPosition
		        local distance = Vector2.Distance(Vector2(playerPosition.x, playerPosition.y), Vector2(portalPosition.x, portalPosition.y))
		        if distance > 0.9 then return end
		        log("[LexioPortalInput] UP route=LEXIO_PLAY distance=" .. tostring(distance))
		        -- Entrance travel is validated independently so a stale per-player bridge
		        -- left over from map01 cannot reject the lobby as invalid_source_map.
		        self:RequestEntranceTravel(player)
	end

end