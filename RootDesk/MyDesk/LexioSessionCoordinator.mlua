@Component
script LexioSessionCoordinator extends Component

	property Entity SessionEntity = ""

	property table userIdBySeat = {}

	property table seatByUserId = {}

	property table playerEntityBySeat = {}

	property table bridgeByUserId = {}

	property table readyBySeat = {}

	property table seatedBySeat = {}

	property table chairBySeat = {}

	property boolean startCountdownActive = false

	property number startCountdown = 0

	property integer startCountdownSecond = -1

	property table spectatorByUserId = {}

	property boolean startRequested = false

	property boolean finishedResultsPublished = false

	property table registrationRetryByUserId = {}

	property table registrationGenerationByUserId = {}

	property integer finishGeneration = 0

	property number finishCountdown = 0

	property integer finishCountdownSecond = -1

	property table finishDecisionByUserId = {}

	property table winsBySeat = {}

	property boolean finishReturnStarted = false

	property boolean finishDecisionActive = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		        self.SessionEntity = self.Entity
		        if self.Entity.CurrentMapName == "lexio_session_tests" then
		            local runner = self.Entity.Parent
		            if runner ~= nil and runner.Name == "LexioSessionTestRunner" and runner:GetComponent("script.LexioGameSession") ~= nil then self.SessionEntity = runner end
		        end
		        self.userIdBySeat = {}
		        self.seatByUserId = {}
		        self.playerEntityBySeat = {}
		        self.bridgeByUserId = {}
		        self.readyBySeat = { false, false, false }
		        self.seatedBySeat = { false, false, false }
		        self.chairBySeat = { "", "", "" }
		        self.startCountdownActive = false
		        self.startCountdown = 0
		        self.startCountdownSecond = -1
		        self.spectatorByUserId = {}
		        self.startRequested = false
		        self.finishedResultsPublished = false
		        self.registrationRetryByUserId = {}
		        self.registrationGenerationByUserId = {}
		        self.finishGeneration = 0
		        self.finishCountdown = 0
		        self.finishCountdownSecond = -1
		        self.finishDecisionByUserId = {}
		        self.winsBySeat = { 0, 0, 0 }
		        self.finishReturnStarted = false
		        self.finishDecisionActive = false
		        self:RegisterCurrentMapPlayers()
		        log("[LexioSessionCoordinator] READY map=" .. self.Entity.CurrentMap.Name)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		        if self.startCountdownActive then
		            if not self:CanStartFromSeats() then
		                self:CancelStartCountdown("seat_changed")
		            else
		                self.startCountdown = math.max(0, self.startCountdown - delta)
		                local startSecond = math.ceil(self.startCountdown)
		                if startSecond ~= self.startCountdownSecond then
		                    self.startCountdownSecond = startSecond
		                    log("[LexioSessionCoordinator] START COUNTDOWN second=" .. tostring(startSecond))
		                    self:BroadcastSnapshots()
		                end
		                if self.startCountdown <= 0 then self:CompleteStartCountdown() end
		            end
		        end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session ~= nil and session.phase == "Finished" and self.finishedResultsPublished and not self.finishReturnStarted then
		            if not self.finishDecisionActive then self:BeginFinishedDecision() end
		            self.finishCountdown = math.max(0, self.finishCountdown - delta)
		            local second = math.ceil(self.finishCountdown)
		            if second ~= self.finishCountdownSecond then
		                self.finishCountdownSecond = second
		                self:BroadcastSnapshots()
		            end
		            if self.finishCountdown <= 0 then self:ReturnAllFinishedPlayers("timeout") end
		        end
		        for userId, retry in pairs(self.registrationRetryByUserId) do
		            retry.elapsed = retry.elapsed + delta
		            if retry.elapsed >= 0.5 then
		                retry.elapsed = 0
		                retry.attempts = retry.attempts + 1
		                local playerEntity = _UserService:GetUserEntityByUserId(userId)
		                if self.registrationGenerationByUserId[userId] ~= retry.generation then
		                    self.registrationRetryByUserId[userId] = nil
		                elseif self:RegisterPlayer(playerEntity, userId) then
		                    self.registrationRetryByUserId[userId] = nil
		                    log("[LexioSessionCoordinator] REGISTRATION RETRY stopped userId=" .. userId .. " reason=registered attempts=" .. tostring(retry.attempts))
		                elseif retry.attempts >= 6 then
		                    self.registrationRetryByUserId[userId] = nil
		                    log("[LexioSessionCoordinator] REGISTRATION RETRY stopped userId=" .. userId .. " reason=timeout attempts=" .. tostring(retry.attempts))
		                end
		            end
		        end
	end

	@ExecSpace("ServerOnly")
	method void BeginFinishedDecision()
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or session.phase ~= "Finished" or not self.finishedResultsPublished then return end
		        self.finishGeneration = self.finishGeneration + 1
		        self.finishCountdown = 10
		        self.finishCountdownSecond = 10
		        self.finishDecisionByUserId = {}
		        self.finishReturnStarted = false
		        self.finishDecisionActive = true
		        if session.winnerIndex >= 1 and session.winnerIndex <= 3 then
		            self.winsBySeat[session.winnerIndex] = (self.winsBySeat[session.winnerIndex] or 0) + 1
		        end
		        log("[LexioSessionCoordinator] FINISHED generation=" .. tostring(self.finishGeneration) .. " winner=" .. tostring(session.winnerIndex))
	end

	@ExecSpace("ServerOnly")
	method table SubmitFinishDecision(string userId, Entity playerEntity, string decision, integer generation)
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or session.phase ~= "Finished" or not self.finishedResultsPublished then return { ok = false, reason = "results_pending" } end
		        if generation ~= self.finishGeneration or generation <= 0 then return { ok = false, reason = "stale_generation" } end
		        local seat = self.seatByUserId[userId]
		        if seat == nil or self.playerEntityBySeat[seat] ~= playerEntity then return { ok = false, reason = "player_mismatch" } end
		        if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return { ok = false, reason = "player_mismatch" } end
		        if decision ~= "Replay" and decision ~= "Exit" then return { ok = false, reason = "invalid_decision" } end
		        if self.finishDecisionByUserId[userId] ~= nil then return { ok = true, reason = "duplicate" } end
		        self.finishDecisionByUserId[userId] = decision
		        log("[LexioSessionCoordinator] FINISH DECISION userId=" .. userId .. " decision=" .. decision .. " generation=" .. tostring(generation))
		        if decision == "Exit" then
		            self:ReturnAllFinishedPlayers("exit")
		        elseif self.finishDecisionByUserId[self.userIdBySeat[1]] == "Replay" and self.finishDecisionByUserId[self.userIdBySeat[2]] == "Replay" and self.finishDecisionByUserId[self.userIdBySeat[3]] == "Replay" then
		            self:StartReplayRound()
		        else
		            self:BroadcastSnapshots()
		        end
		        return { ok = true, reason = "" }
	end

	@ExecSpace("ServerOnly")
	method void StartReplayRound()
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or session.phase ~= "Finished" or self.finishReturnStarted then return end
		        local users = { self.userIdBySeat[1], self.userIdBySeat[2], self.userIdBySeat[3] }
		        if users[1] == nil or users[2] == nil or users[3] == nil then self:ReturnAllFinishedPlayers("missing_player") return end
		        session:ResetSession()
		        self.startRequested = true
		        self.finishedResultsPublished = false
		        self.finishDecisionByUserId = {}
		        self.finishCountdown = 0
		        self.finishCountdownSecond = -1
		        self.finishDecisionActive = false
		        local result = session:StartGame(users, nil)
		        log("[LexioSessionCoordinator] REPLAY START generation=" .. tostring(self.finishGeneration) .. " ok=" .. tostring(result.ok) .. " reason=" .. result.reason)
		        if result.ok then self:BroadcastSnapshots() else self:ReturnAllFinishedPlayers("replay_failed") end
	end

	@ExecSpace("ServerOnly")
	method void ReturnAllFinishedPlayers(string reason)
		        if self.finishReturnStarted then return end
		        self.finishReturnStarted = true
		        self.finishDecisionActive = false
		        local generation = self.finishGeneration
		        local users = { self.userIdBySeat[1], self.userIdBySeat[2], self.userIdBySeat[3] }
		        local players = { self.playerEntityBySeat[1], self.playerEntityBySeat[2], self.playerEntityBySeat[3] }
		        log("[LexioSessionCoordinator] RETURN ALL reason=" .. reason .. " generation=" .. tostring(generation))
		        for seat = 1, 3 do
		            local player = players[seat]
		            local userId = users[seat]
		            if player ~= nil and isvalid(player) and userId ~= nil and player.PlayerComponent ~= nil and player.PlayerComponent.UserId == userId then
		                local travel = player:GetComponent("script.LexioTravelBridge")
		                if travel ~= nil then travel:ReturnFinishedPlayerToLobby(userId, generation) end
		            end
		        end
	end

	@ExecSpace("ServerOnly")
	method void StartRegistrationRetry(string userId)
		        if userId == nil or userId == "" then return end
		        local generation = (self.registrationGenerationByUserId[userId] or 0) + 1
		        self.registrationGenerationByUserId[userId] = generation
		        self.registrationRetryByUserId[userId] = { elapsed = 0, attempts = 0, generation = generation }
		        log("[LexioSessionCoordinator] REGISTRATION RETRY started userId=" .. userId .. " generation=" .. tostring(generation))
	end

	@ExecSpace("ServerOnly")
	method void RegisterCurrentMapPlayers()
		        local players = _UserService:GetUsersByMapComponent(self.Entity.CurrentMap.MapComponent)
		        if players == nil then return end
		        for _, playerEntity in ipairs(players) do
		            if playerEntity ~= nil and isvalid(playerEntity) and playerEntity.PlayerComponent ~= nil then
		                self:RegisterPlayer(playerEntity, playerEntity.PlayerComponent.UserId)
		            end
		        end
	end

	method integer FindOpenSeat()
		        for seat = 1, 3 do
		            if self.userIdBySeat[seat] == nil then return seat end
		        end
		        return 0
	end

	@ExecSpace("ServerOnly")
	method any AttachBridge(Entity playerEntity, string userId, integer seat, string role)
		        local bridge = playerEntity:GetComponent("script.LexioPlayerBridge")
		        if bridge == nil then bridge = playerEntity:AddComponent("script.LexioPlayerBridge") end
		        if bridge == nil then return nil end
		        bridge:BindServer(self.SessionEntity, self.Entity, playerEntity, userId, seat, role)
		        self.bridgeByUserId[userId] = bridge
		
		        -- Test-only controls are runtime-attached on map01 and absent from DefaultPlayer.model.
		        local controls = playerEntity:GetComponent("script.LexioManualTestControls")
		        if controls == nil then playerEntity:AddComponent("script.LexioManualTestControls") end
		        return bridge
	end

	@ExecSpace("ServerOnly")
	method boolean RegisterPlayer(Entity playerEntity, string userId)
		        if playerEntity == nil or not isvalid(playerEntity) then return false end
		        if playerEntity.PlayerComponent == nil then return false end
		        if playerEntity.PlayerComponent.UserId ~= userId then return false end
		        if playerEntity.CurrentMap ~= self.Entity.CurrentMap then return false end
		        self.registrationRetryByUserId[userId] = nil
		
		        local existingSeat = self.seatByUserId[userId]
		        if existingSeat ~= nil then
		            local existingBridge = self.bridgeByUserId[userId]
		            if self.playerEntityBySeat[existingSeat] == playerEntity and existingBridge ~= nil and isvalid(existingBridge.Entity) then return true end
		            self.playerEntityBySeat[existingSeat] = playerEntity
		            self:AttachBridge(playerEntity, userId, existingSeat, "Player")
		            return true
		        end
		
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        local seat = 0
		        if session ~= nil and session.phase == "WaitingPlayers" and not self.startRequested then seat = self:FindOpenSeat() end
		        if seat == 0 then
		            self.spectatorByUserId[userId] = true
		            self:AttachBridge(playerEntity, userId, 0, "Spectator")
		            log("[LexioSessionCoordinator] SPECTATOR userId=" .. userId)
		            return true
		        end
		
		        self.userIdBySeat[seat] = userId
		        self.seatByUserId[userId] = seat
		        self.playerEntityBySeat[seat] = playerEntity
		        self.readyBySeat[seat] = false
		        self:AttachBridge(playerEntity, userId, seat, "Player")
		        log("[LexioSessionCoordinator] JOIN userId=" .. userId .. " seat=" .. tostring(seat))
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean RegisterPlayerEntity(Entity playerEntity)
		        if playerEntity == nil or not isvalid(playerEntity) then return false end
		        if playerEntity.PlayerComponent == nil then return false end
		        local userId = playerEntity.PlayerComponent.UserId
		        if userId == nil or userId == "" then return false end
		        if playerEntity.CurrentMap ~= self.Entity.CurrentMap or playerEntity.CurrentMapName ~= "map01" then return false end
		        return self:RegisterPlayer(playerEntity, userId)
	end

	@ExecSpace("ServerOnly")
	method void RemovePlayer(string userId)
		        local seat = self.seatByUserId[userId]
		        self.bridgeByUserId[userId] = nil
		        self.spectatorByUserId[userId] = nil
		        if seat == nil then return end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session ~= nil and ((session.phase == "WaitingPlayers" and not self.startRequested) or session.phase == "Finished") then
		            self.userIdBySeat[seat] = nil
		            self.seatByUserId[userId] = nil
		            self.playerEntityBySeat[seat] = nil
		            self.readyBySeat[seat] = false
		            self.seatedBySeat[seat] = false
		            self.chairBySeat[seat] = ""
		            self:CancelStartCountdown("player_left")
		        end
		        log("[LexioSessionCoordinator] LEAVE userId=" .. userId .. " seat=" .. tostring(seat))
	end

	@ExecSpace("ServerOnly")
	method boolean RemovePlayerEntity(Entity playerEntity)
		        if playerEntity == nil or not isvalid(playerEntity) or playerEntity.PlayerComponent == nil then return false end
		        local userId = playerEntity.PlayerComponent.UserId
		        if userId == nil or userId == "" then return false end
		        self.registrationRetryByUserId[userId] = nil
		        self.registrationGenerationByUserId[userId] = (self.registrationGenerationByUserId[userId] or 0) + 1
		        local seat = self.seatByUserId[userId]
		        if seat == nil then return true end
		        if self.playerEntityBySeat[seat] ~= playerEntity then return false end
		        self:RemovePlayer(userId)
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean IsExitPhaseAllowed(string phase)
		        return phase == "WaitingPlayers" or phase == "Finished"
	end

	@ExecSpace("ServerOnly")
	method string GetExitRejectionReason(string userId, Entity playerEntity)
		        local seat = self.seatByUserId[userId]
		        if seat == nil then return "not_registered" end
		        if self.playerEntityBySeat[seat] ~= playerEntity then return "player_mismatch" end
		        if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return "player_mismatch" end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil then return "missing_session" end
		        if session.phase == "Playing" or session.phase == "LeadPending" then return "game_in_progress" end
		        if session.phase == "Finished" and not self.finishedResultsPublished then return "results_pending" end
		        if self:IsExitPhaseAllowed(session.phase) then return "" end
		        return "exit_not_allowed"
	end

	@ExecSpace("ServerOnly")
	method boolean PreparePlayerExit(string userId, Entity playerEntity)
		        if self:GetExitRejectionReason(userId, playerEntity) ~= "" then return false end
		        self:RemovePlayer(userId)
		        self:BroadcastSnapshots()
		        return true
	end

	@ExecSpace("ServerOnly")
	method void MarkReady(string userId, Entity playerEntity)
		        local seat = self.seatByUserId[userId]
		        if seat == nil then return end
		        if self.playerEntityBySeat[seat] ~= playerEntity then return end
		        if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return end
		        if self.readyBySeat[seat] then return end
		        self.readyBySeat[seat] = true
		        log("[LexioSessionCoordinator] CLIENT READY userId=" .. userId .. " seat=" .. tostring(seat))
		        -- WaitingPlayers also has a public lobby snapshot so joined clients can render seats.
		        self:BroadcastSnapshots()
		        self:TryStartGame()
	end

	@ExecSpace("ServerOnly")
	method boolean CanStartFromSeats()
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or session.phase ~= "WaitingPlayers" or self.startRequested then return false end
		        for seat = 1, 3 do
		            if self.userIdBySeat[seat] == nil or not self.readyBySeat[seat] or not self.seatedBySeat[seat] then return false end
		            if self.chairBySeat[seat] == nil or self.chairBySeat[seat] == "" then return false end
		        end
		        return true
	end

	@ExecSpace("ServerOnly")
	method void CancelStartCountdown(string reason)
		        if not self.startCountdownActive then return end
		        self.startCountdownActive = false
		        self.startCountdown = 0
		        self.startCountdownSecond = -1
		        log("[LexioSessionCoordinator] START COUNTDOWN CANCEL reason=" .. tostring(reason))
		        self:BroadcastSnapshots()
	end

	@ExecSpace("ServerOnly")
	method boolean SetSeatState(string userId, Entity playerEntity, boolean seated, string chairName)
		        local seat = self.seatByUserId[userId]
		        if seat == nil or self.playerEntityBySeat[seat] ~= playerEntity then return false end
		        if playerEntity == nil or not isvalid(playerEntity) or playerEntity.PlayerComponent == nil then return false end
		        if playerEntity.PlayerComponent.UserId ~= userId or playerEntity.CurrentMap ~= self.Entity.CurrentMap then return false end
		        if seated then
		            if chairName ~= "LexioChair1" and chairName ~= "LexioChair2" and chairName ~= "LexioChair3" then return false end
		            for otherSeat = 1, 3 do
		                if otherSeat ~= seat and self.seatedBySeat[otherSeat] and self.chairBySeat[otherSeat] == chairName then return false end
		            end
		            self.seatedBySeat[seat] = true
		            self.chairBySeat[seat] = chairName
		            log("[LexioSessionCoordinator] SEATED userId=" .. userId .. " seat=" .. tostring(seat) .. " chair=" .. chairName)
		        else
		            self.seatedBySeat[seat] = false
		            self.chairBySeat[seat] = ""
		            log("[LexioSessionCoordinator] STOOD userId=" .. userId .. " seat=" .. tostring(seat))
		            self:CancelStartCountdown("player_stood")
		        end
		        self:BroadcastSnapshots()
		        self:TryStartGame()
		        return true
	end

	@ExecSpace("ServerOnly")
	method void TryStartGame()
		        if self.Entity.CurrentMapName == "map01" then return end
		        if self.startCountdownActive or not self:CanStartFromSeats() then return end
		        self.startCountdownActive = true
		        self.startCountdown = 3
		        self.startCountdownSecond = 3
		        log("[LexioSessionCoordinator] START COUNTDOWN begin seconds=3")
		        self:BroadcastSnapshots()
	end

	@ExecSpace("ServerOnly")
	method void CompleteStartCountdown()
		        if not self.startCountdownActive or not self:CanStartFromSeats() then return end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil then return end
		        self.startCountdownActive = false
		        self.startCountdown = 0
		        self.startCountdownSecond = -1
		        -- Lock before invoking StartGame so the countdown cannot complete twice.
		        self.startRequested = true
		        local result = session:StartGame({ self.userIdBySeat[1], self.userIdBySeat[2], self.userIdBySeat[3] }, nil)
		        log("[LexioSessionCoordinator] START invoked ok=" .. tostring(result.ok) .. " reason=" .. result.reason)
		        if result.ok then self:BroadcastSnapshots() end
	end

	@ExecSpace("ServerOnly")
	method void BroadcastSnapshots()
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session ~= nil and session.phase == "Finished" then
		            self.finishedResultsPublished = true
		            if not self.finishDecisionActive then self:BeginFinishedDecision() end
		        end
		        for _, bridge in pairs(self.bridgeByUserId) do
		            if bridge ~= nil and isvalid(bridge.Entity) then bridge:PushCurrentSnapshot() end
		        end
	end

	@ExecSpace("ServerOnly")
	method table BuildClientPublicSnapshot()
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil then return nil end
		        local snapshot = nil
		        if session.phase == "WaitingPlayers" then
		            snapshot = {
		                phase = "WaitingPlayers",
		                currentPlayerIndex = 0,
		                winningPlayerIndex = 0,
		                remainingCounts = { 0, 0, 0 },
		                passed = { false, false, false },
		                lastPlay = {},
		                trickNumber = 0,
		                turnNumber = 0,
		                stateVersion = session.stateVersion,
		                winnerIndex = 0
		            }
		        else
		            snapshot = session:BuildPublicSnapshot()
		        end
		        local seatNames = { "", "", "" }
		        for seat = 1, 3 do
		            local player = self.playerEntityBySeat[seat]
		            if player ~= nil and isvalid(player) then
		                local nickname = player.Name
		                if player.NameTagComponent ~= nil and player.NameTagComponent.Name ~= "" then
		                    nickname = player.NameTagComponent.Name
		                end
		                seatNames[seat] = nickname
		            end
		        end
		        snapshot.seatNames = seatNames
		        snapshot.hasCurrentPlay = session.currentPlay ~= nil
		        snapshot.finishGeneration = self.finishGeneration
		        snapshot.finishCountdown = math.ceil(self.finishCountdown)
		        snapshot.finishReplayCount = 0
		        for _, decision in pairs(self.finishDecisionByUserId) do if decision == "Replay" then snapshot.finishReplayCount = snapshot.finishReplayCount + 1 end end
		        snapshot.winsBySeat = { self.winsBySeat[1] or 0, self.winsBySeat[2] or 0, self.winsBySeat[3] or 0 }
		        return snapshot
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		        local playerEntity = _UserService:GetUserEntityByUserId(event.UserId)
		        if self:RegisterPlayer(playerEntity, event.UserId) then return end
		        self:StartRegistrationRetry(event.UserId)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		        self.registrationRetryByUserId[event.UserId] = nil
		        self.registrationGenerationByUserId[event.UserId] = (self.registrationGenerationByUserId[event.UserId] or 0) + 1
		        self:RemovePlayer(event.UserId)
	end

end