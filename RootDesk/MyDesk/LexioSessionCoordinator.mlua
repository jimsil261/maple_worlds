@Component
script LexioSessionCoordinator extends Component

	property Entity SessionEntity = ""

	property string TableId = ""

	property integer RequiredPlayerCount = 3

	property table userIdBySeat = {}

	property table seatByUserId = {}

	property table playerEntityBySeat = {}

	property table bridgeByUserId = {}

	property table readyBySeat = {}

	property boolean explicitReadyRequired = false

	property table explicitReadyBySeat = {}

	property string privateRoomCode = ""

	property table seatedBySeat = {}

	property table chairBySeat = {}

	property boolean startCountdownActive = false

	property number startCountdown = 0

	property integer startCountdownSecond = -1

	property table spectatorByUserId = {}

	property boolean startRequested = false

	property boolean finishedResultsPublished = false

	property table registrationRetryByUserId = {}

	property table registrationGenerationByUserId = {}

	property integer finishGeneration = 0

	property number finishCountdown = 0

	property integer finishCountdownSecond = -1

	property table finishDecisionByUserId = {}

	property table winsBySeat = {}

	property boolean finishReturnStarted = false

	property boolean finishDecisionActive = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		if self._T.BootInitialized then return end
		self._T.BootInitialized = true
		        -- Reset the turn clock for each Maker play session.
		        self._T.FinishedWithAI = false
		        self._T.ClockVersion = nil
		        self._T.TurnSecondsRemaining = 0
		        self._T.TurnCountdown = 0
		        self._T.DisconnectedSeconds = {}
		        self._T.DisconnectGeneration = {}
		        self._T.AIBySeat = {}
		        self._T.KickedBySeat = {}
		        self._T.DisconnectVotes = {}
		        self._T.DisconnectBallotVotes = {}
		        self._T.DisconnectBallotGeneration = 0
		        self._T.SeatNames = {}
		        self.SessionEntity = self.Entity
		        if self.Entity.CurrentMapName == "lexio_session_tests" then
		            local runner = self.Entity.Parent
		            if runner ~= nil and runner.Name == "LexioSessionTestRunner" and runner:GetComponent("script.LexioGameSession") ~= nil then self.SessionEntity = runner end
		        end
		        self.userIdBySeat = {}
		        self.seatByUserId = {}
		        self.playerEntityBySeat = {}
		        self.bridgeByUserId = {}
		        self.readyBySeat = {}
		        self.explicitReadyBySeat = {}
		        self.seatedBySeat = {}
		        self.chairBySeat = {}
		        for seat = 1, self.RequiredPlayerCount do
		            self.readyBySeat[seat] = false
		            self.explicitReadyBySeat[seat] = false
		            self.seatedBySeat[seat] = false
		            self.chairBySeat[seat] = ""
		        end
		        self.startCountdownActive = false
		        self.startCountdown = 0
		        self.startCountdownSecond = -1
		        self.explicitReadyRequired = false
		        self.privateRoomCode = ""
		        self.spectatorByUserId = {}
		        self.startRequested = false
		        self.finishedResultsPublished = false
		        self.registrationRetryByUserId = {}
		        self.registrationGenerationByUserId = {}
		        self.finishGeneration = 0
		        self.finishCountdown = 0
		        self.finishCountdownSecond = -1
		        self.finishDecisionByUserId = {}
		        self.winsBySeat = {}
		        for seat = 1, self.RequiredPlayerCount do self.winsBySeat[seat] = 0 end
		        self.finishReturnStarted = false
		        self.finishDecisionActive = false
		        if self.TableId == "" then self:RegisterCurrentMapPlayers() end
		        log("[LexioSessionCoordinator] READY map=" .. self.Entity.CurrentMap.Name .. " table=" .. self.TableId)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		        -- Advance the server-owned turn clock independently of client input.
		        self:RecycleAbandonedGame()
		        self:UpdateConnections(delta)
		        self:UpdateTurnClock(delta)
		        if self.startCountdownActive then
		            if not self:CanStartFromSeats() then
		                self:CancelStartCountdown("seat_changed")
		            else
		                self.startCountdown = math.max(0, self.startCountdown - delta)
		                local startSecond = math.ceil(self.startCountdown)
		                if startSecond ~= self.startCountdownSecond then
		                    self.startCountdownSecond = startSecond
		                    log("[LexioSessionCoordinator] START COUNTDOWN second=" .. tostring(startSecond))
		                    self:BroadcastSnapshots()
		                end
		                if self.startCountdown <= 0 then self:CompleteStartCountdown() end
		            end
		        end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session ~= nil and session.phase == "Finished" and self.finishedResultsPublished and not self.finishReturnStarted then
		            if not self.finishDecisionActive then self:BeginFinishedDecision() end
		            self.finishCountdown = math.max(0, self.finishCountdown - delta)
		            local second = math.ceil(self.finishCountdown)
		            if second ~= self.finishCountdownSecond then
		                self.finishCountdownSecond = second
		                self:BroadcastSnapshots()
		            end
		            if self.finishCountdown <= 0 then self:ReturnAllFinishedPlayers("timeout") end
		        end
		        for userId, retry in pairs(self.registrationRetryByUserId) do
		            retry.elapsed = retry.elapsed + delta
		            if retry.elapsed >= 0.5 then
		                retry.elapsed = 0
		                retry.attempts = retry.attempts + 1
		                local playerEntity = _UserService:GetUserEntityByUserId(userId)
		                if self.registrationGenerationByUserId[userId] ~= retry.generation then
		                    self.registrationRetryByUserId[userId] = nil
		                elseif self:RegisterPlayer(playerEntity, userId) then
		                    self.registrationRetryByUserId[userId] = nil
		                    log("[LexioSessionCoordinator] REGISTRATION RETRY stopped userId=" .. userId .. " reason=registered attempts=" .. tostring(retry.attempts))
		                elseif retry.attempts >= 6 then
		                    self.registrationRetryByUserId[userId] = nil
		                    log("[LexioSessionCoordinator] REGISTRATION RETRY stopped userId=" .. userId .. " reason=timeout attempts=" .. tostring(retry.attempts))
		                end
		            end
		        end
	end

	@ExecSpace("ServerOnly")
	method void BeginFinishedDecision()
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or session.phase ~= "Finished" or not self.finishedResultsPublished then return end
		        self._T.FinishedWithAI = self:HasAISeat()
		        self.finishGeneration = self.finishGeneration + 1
		        self.finishCountdown = 30
		        self.finishCountdownSecond = 30
		        self.finishDecisionByUserId = {}
		        self.finishReturnStarted = false
		        self.finishDecisionActive = true
		        if session.winnerIndex >= 1 and session.winnerIndex <= self.RequiredPlayerCount then
		            self.winsBySeat[session.winnerIndex] = (self.winsBySeat[session.winnerIndex] or 0) + 1
		        end
		        log("[LexioSessionCoordinator] FINISHED generation=" .. tostring(self.finishGeneration) .. " winner=" .. tostring(session.winnerIndex))
	end

	@ExecSpace("ServerOnly")
	method void UpdateTurnClock(number delta)
		        -- Reset for each committed turn; publish seconds and resolve expiry on the server.
		        if self.SessionEntity == nil then return end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil then return end
		        if session.phase ~= "Playing" and session.phase ~= "LeadPending" then
		            self._T.ClockVersion = nil
		            self._T.TurnSecondsRemaining = 0
		            return
		        end
		        if self:HasPendingDisconnect() then return end
		        if self._T.ClockVersion ~= session.stateVersion then
		            self._T.ClockVersion = session.stateVersion
		            self._T.TurnCountdown = self._T.AIBySeat[session.currentPlayerIndex] and 1.5 or 15
		            self._T.TurnSecondsRemaining = math.ceil(self._T.TurnCountdown)
		            log("[VRF] TURN CLOCK start seat=" .. tostring(session.currentPlayerIndex) .. " seconds=15")
		            self:BroadcastSnapshots()
		            return
		        end
		        if self._T.DisconnectedSeconds[session.currentPlayerIndex] ~= nil and not self._T.AIBySeat[session.currentPlayerIndex] then return end
		        if self._T.AIBySeat[session.currentPlayerIndex] then self._T.TurnCountdown = math.min(self._T.TurnCountdown, 1.5) end
		        self._T.TurnCountdown = math.max(0, self._T.TurnCountdown - delta)
		        local seconds = math.ceil(self._T.TurnCountdown)
		        if seconds ~= self._T.TurnSecondsRemaining then
		            self._T.TurnSecondsRemaining = seconds
		            self:BroadcastSnapshots()
		        end
		        if seconds > 0 then return end
		        local seat = session.currentPlayerIndex
		        local userId = session.userIds[seat]
		        if userId == nil then return end
		        local result = nil
		        if session.phase == "Playing" and session.currentPlay ~= nil and seat ~= session.winningPlayerIndex then
		            local tileIds = self._T.AIBySeat[seat] and self:FindAIPlay(seat) or nil
		            if tileIds ~= nil then
		                result = session:SubmitForUser(userId, tileIds, session.stateVersion)
		            else
		                result = session:PassForUser(userId, session.stateVersion)
		            end
		        else
		            -- A leading player cannot pass: submit the weakest legal single.
		            local weakest = nil
		            for _, tile in ipairs(session.hands[seat] or {}) do
		                local strength = tile.rank <= 2 and tile.rank + 15 or tile.rank
		                local prior = weakest ~= nil and (weakest.rank <= 2 and weakest.rank + 15 or weakest.rank) or 99
		                if weakest == nil or strength < prior or (strength == prior and tile.suit < weakest.suit) then weakest = tile end
		            end
		            if weakest ~= nil then result = session:SubmitForUser(userId, { weakest.id }, session.stateVersion) end
		        end
		        log("[VRF] TURN CLOCK expired seat=" .. tostring(seat) .. " ok=" .. tostring(result ~= nil and result.ok))
		        if result ~= nil and result.ok then
		            self._T.ClockVersion = nil
		            self._T.TurnSecondsRemaining = 15
		            self:BroadcastSnapshots()
		        else
		            self._T.TurnCountdown = 15
		        end
	end

	@ExecSpace("ServerOnly")
	method void MarkDisconnected(string userId)
		        local seat = self.seatByUserId[userId]
		        if seat == nil or self._T.KickedBySeat[seat] then return end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or (session.phase ~= "Playing" and session.phase ~= "LeadPending") then return end
		        if self._T.DisconnectedSeconds[seat] == nil then
		            local player = self.playerEntityBySeat[seat]
		            if player ~= nil and isvalid(player) and player.NameTagComponent ~= nil then self._T.SeatNames[seat] = player.NameTagComponent.Name end
		            self._T.DisconnectedSeconds[seat] = 0
		            self._T.DisconnectGeneration[seat] = (self._T.DisconnectGeneration[seat] or 0) + 1
		            self._T.DisconnectVotes[seat] = {}
		            local bridge = self.bridgeByUserId[userId]
		            if bridge ~= nil then bridge.role = "Disconnected" end
		            self.bridgeByUserId[userId] = nil
		            self.playerEntityBySeat[seat] = nil
		            self:ResetDisconnectBallot()
		            log("[VRF] DISCONNECT vote_pending=true seat=" .. tostring(seat))
		            self:BroadcastSnapshots()
		        end
	end

	@ExecSpace("ServerOnly")
	method void UpdateConnections(number delta)
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or (session.phase ~= "Playing" and session.phase ~= "LeadPending") then return end
		        local changed = false
		        for seat = 1, self.RequiredPlayerCount do
		            local player = self.playerEntityBySeat[seat]
		            if self._T.DisconnectedSeconds[seat] == nil and (player == nil or not isvalid(player) or player.CurrentMap ~= self.Entity.CurrentMap) then self:MarkDisconnected(self.userIdBySeat[seat]) end
		            local elapsed = self._T.DisconnectedSeconds[seat]
		            if elapsed ~= nil and elapsed < 30 then
		                local nextElapsed = math.min(30, elapsed + delta)
		                self._T.DisconnectedSeconds[seat] = nextElapsed
		                if math.floor(elapsed) ~= math.floor(nextElapsed) then changed = true end
		                -- AI takeover requires a majority vote; elapsed time never overrides the decision.
		            end
		        end
		        if self:HasPendingDisconnect() then
		            local prior = math.ceil(self._T.DisconnectBallotRemaining or 30)
		            self._T.DisconnectBallotRemaining = math.max(0, (self._T.DisconnectBallotRemaining or 30) - delta)
		            if prior ~= math.ceil(self._T.DisconnectBallotRemaining) then changed = true end
		            if self._T.DisconnectBallotRemaining <= 0 then
		                self:ResolveDisconnectBallotTimeout()
		                return
		            end
		        end
		        if changed then self:BroadcastSnapshots() end
	end

	@ExecSpace("ServerOnly")
	method void EnableSeatAI(integer seat, string reason)
		        self._T.AIBySeat[seat] = true
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session ~= nil then session:SetPersistentRewardsEligible(false, "ai_substitution") end
		        log("[VRF] SEAT AI enabled=true seat=" .. tostring(seat) .. " reason=" .. reason)
	end

	method integer GetDisconnectVoteThreshold(integer targetSeat)
		return self:GetDisconnectBallotCounts().required
	end

	@ExecSpace("ServerOnly")
	method table VoteDisconnectedSeat(string userId, Entity playerEntity, integer targetSeat, integer generation, boolean agree)
		local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		if session == nil or (session.phase ~= "Playing" and session.phase ~= "LeadPending") then return { ok = false, reason = "phase" } end
		local voterSeat = self.seatByUserId[userId]
		if voterSeat == nil or voterSeat == targetSeat or self.playerEntityBySeat[voterSeat] ~= playerEntity then return { ok = false, reason = "voter" } end
		if playerEntity == nil or not isvalid(playerEntity) or playerEntity.CurrentMap ~= self.Entity.CurrentMap or playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return { ok = false, reason = "voter" } end
		if targetSeat < 1 or targetSeat > self.RequiredPlayerCount or self._T.KickedBySeat[targetSeat] then return { ok = false, reason = "target" } end
		if generation ~= self._T.DisconnectGeneration[targetSeat] or self._T.DisconnectedSeconds[targetSeat] == nil then return { ok = false, reason = "stale_disconnect" } end
		if self._T.AIBySeat[targetSeat] then return { ok = true, reason = "already_resolved" } end
		self._T.DisconnectBallotVotes = self._T.DisconnectBallotVotes or {}
		if self._T.DisconnectBallotVotes[userId] ~= nil then return { ok = true, reason = "duplicate" } end
		self._T.DisconnectBallotVotes[userId] = agree ~= false
		local votes = self:GetDisconnectBallotCounts()
		log("[VRF] AI CONTINUE VOTE yes=" .. tostring(votes.yes) .. " no=" .. tostring(votes.no) .. " required=" .. tostring(votes.required))
		if votes.yes >= votes.required then
			for seat = 1, self.RequiredPlayerCount do
				if self._T.DisconnectedSeconds[seat] ~= nil and not self._T.KickedBySeat[seat] and not self._T.AIBySeat[seat] then self:EnableSeatAI(seat, "continuation_vote") end
			end
			self:BroadcastSnapshots()
		elseif votes.total - votes.no < votes.required then
			self:AbortRoomForRejectedAI()
		else self:BroadcastSnapshots() end
		return { ok = true, reason = "" }
	end

	@ExecSpace("ServerOnly")
	method boolean ReconnectTablePlayer(string userId, Entity playerEntity)
		        local seat = self.seatByUserId[userId]
		        if seat == nil or self._T.KickedBySeat[seat] or self._T.DisconnectedSeconds[seat] == nil then return false end
		        if playerEntity == nil or not isvalid(playerEntity) or playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId or playerEntity.CurrentMap ~= self.Entity.CurrentMap then return false end
		        self.playerEntityBySeat[seat] = playerEntity
		        self._T.DisconnectedSeconds[seat] = nil
		        self._T.AIBySeat[seat] = nil
		        self._T.DisconnectVotes[seat] = nil
		        self._T.DisconnectGeneration[seat] = (self._T.DisconnectGeneration[seat] or 0) + 1
		        if self._T.SuspendedPlayers ~= nil then self._T.SuspendedPlayers[seat] = nil end
		        self:ResetDisconnectBallot()
		        self:AttachBridge(playerEntity, userId, seat, "Player")
		        log("[VRF] RECONNECT restored seat=" .. tostring(seat))
		        return true
	end

	@ExecSpace("ServerOnly")
	method table SubmitFinishDecision(string userId, Entity playerEntity, string decision, integer generation)
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or session.phase ~= "Finished" or not self.finishedResultsPublished then return { ok = false, reason = "results_pending" } end
		        if generation ~= self.finishGeneration or generation <= 0 then return { ok = false, reason = "stale_generation" } end
		        local seat = self.seatByUserId[userId]
		        if seat == nil or self.playerEntityBySeat[seat] ~= playerEntity then return { ok = false, reason = "player_mismatch" } end
		        if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return { ok = false, reason = "player_mismatch" } end
		        if decision ~= "Replay" and decision ~= "Exit" then return { ok = false, reason = "invalid_decision" } end
		        if decision == "Replay" and self._T.FinishedWithAI then return { ok = false, reason = "ai_match_finished" } end
		        if self.finishDecisionByUserId[userId] ~= nil then return { ok = true, reason = "duplicate" } end
		        self.finishDecisionByUserId[userId] = decision
		        log("[LexioSessionCoordinator] FINISH DECISION userId=" .. userId .. " decision=" .. decision .. " generation=" .. tostring(generation))
		        if decision == "Exit" then
		            self:ReturnAllFinishedPlayers("exit")
		        elseif self:AreAllPlayersReplaying() then
		            self:StartReplayRound()
		        else
		            self:BroadcastSnapshots()
		        end
		        return { ok = true, reason = "" }
	end

	@ExecSpace("ServerOnly")
	method void StartReplayRound()
		if self._T.FinishedWithAI or self:HasAISeat() then return end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or session.phase ~= "Finished" or self.finishReturnStarted then return end
		        local users = self:BuildRequiredUsers()
		        if #users ~= self.RequiredPlayerCount then self:ReturnAllFinishedPlayers("missing_player") return end
		        local previousScores = {}
		        for seat = 1, self.RequiredPlayerCount do previousScores[seat] = session.scoreLedger[seat] or 64 end
		        session:ResetSession()
		        self.startRequested = true
		        self.finishedResultsPublished = false
		        self.finishDecisionByUserId = {}
		        self.finishCountdown = 0
		        self.finishCountdownSecond = -1
		        self.finishDecisionActive = false
		        local result = session:StartGame(users, nil)
		        log("[LexioSessionCoordinator] REPLAY START generation=" .. tostring(self.finishGeneration) .. " ok=" .. tostring(result.ok) .. " reason=" .. result.reason)
		        if result.ok then
		            session.scoreLedger = previousScores
		            log("[VRF] REPLAY SCORE CARRY players=" .. tostring(#previousScores))
		            self:BroadcastSnapshots()
		        else
		            self:ReturnAllFinishedPlayers("replay_failed")
		        end
	end

	@ExecSpace("ServerOnly")
	method void ReturnAllFinishedPlayers(string reason)
		        -- Release every player into the static public browser, then recycle the table.
		        if self.finishReturnStarted then return end
		        self.finishReturnStarted = true
		        self.startRequested = false
		        self.finishDecisionActive = false
		        local generation = self.finishGeneration
		        local users = self:BuildRequiredUsers()
		        local players = self:BuildRequiredPlayers()
		        log("[LexioSessionCoordinator] RETURN ALL reason=" .. reason .. " generation=" .. tostring(generation))
		        for seat = 1, self.RequiredPlayerCount do
		            local player = players[seat]
		            local userId = users[seat]
		            if player ~= nil and isvalid(player) and userId ~= nil and player.PlayerComponent ~= nil and player.PlayerComponent.UserId == userId then
		                self:ReleaseFinishedParticipant(userId, player)
		            end
		        end
		        self:ReleaseDisconnectedSeats()
		        if next(self.seatByUserId) == nil then
		            local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		            if session ~= nil then session:ResetSession() end
		            self.finishedResultsPublished = false
		            self.finishCountdown = 0
		            self._T.ClockVersion = nil
		            log("[VRF] FINISHED TABLE recycled=true table=" .. self.TableId)
		        end
	end

	@ExecSpace("ServerOnly")
	method void ReleaseDisconnectedSeats()
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or (session.phase ~= "WaitingPlayers" and session.phase ~= "Finished") then return end
		        local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		        local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		        for seat = 1, self.RequiredPlayerCount do
		            local userId = self.userIdBySeat[seat]
		            local player = self.playerEntityBySeat[seat]
		            if userId ~= nil and (player == nil or not isvalid(player) or player.CurrentMap ~= self.Entity.CurrentMap) then
		                if registry ~= nil then
		                    if not self._T.KickedBySeat[seat] then
		                        self:ReleaseFinishedParticipant(userId, registry.playerByUserId[userId])
		                    end
		                    registry:ReleaseReplacedSeat(userId, self.TableId, seat)
		                    if self.seatByUserId[userId] ~= nil then self:RemovePlayer(userId) end
		                else
		                    self:RemovePlayer(userId)
		                end
		                log("[VRF] DISCONNECTED SEAT released table=" .. self.TableId .. " seat=" .. tostring(seat))
		            end
		        end
	end

	@ExecSpace("ServerOnly")
	method void RecycleAbandonedGame()
		        if self.TableId == "" or not self.startRequested or self.SessionEntity == nil then return end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or (session.phase ~= "Playing" and session.phase ~= "LeadPending") then return end
		        for seat = 1, self.RequiredPlayerCount do
		            local player = self.playerEntityBySeat[seat]
		            if player ~= nil and isvalid(player) and player.CurrentMap == self.Entity.CurrentMap then return end
		        end
		        for _, player in pairs(self._T.SuspendedPlayers or {}) do
		            if player ~= nil and isvalid(player) and player.CurrentMap == self.Entity.CurrentMap then return end
		        end
		        -- Nobody can receive a result: release ownership without awarding a fabricated win.
		        session:ResetSession()
		        self.startRequested = false
		        self.finishDecisionActive = false
		        self.finishedResultsPublished = false
		        self.finishReturnStarted = true
		        self._T.ClockVersion = nil
		        self:ReleaseDisconnectedSeats()
		        log("[VRF] ABANDONED TABLE recycled=true table=" .. self.TableId)
	end

	@ExecSpace("ServerOnly")
	method void StartRegistrationRetry(string userId)
		        if userId == nil or userId == "" then return end
		        local generation = (self.registrationGenerationByUserId[userId] or 0) + 1
		        self.registrationGenerationByUserId[userId] = generation
		        self.registrationRetryByUserId[userId] = { elapsed = 0, attempts = 0, generation = generation }
		        log("[LexioSessionCoordinator] REGISTRATION RETRY started userId=" .. userId .. " generation=" .. tostring(generation))
	end

	@ExecSpace("ServerOnly")
	method void RegisterCurrentMapPlayers()
		        local players = _UserService:GetUsersByMapComponent(self.Entity.CurrentMap.MapComponent)
		        if players == nil then return end
		        for _, playerEntity in ipairs(players) do
		            if playerEntity ~= nil and isvalid(playerEntity) and playerEntity.PlayerComponent ~= nil then
		                self:RegisterPlayer(playerEntity, playerEntity.PlayerComponent.UserId)
		            end
		        end
	end

	method table BuildRequiredUsers()
		        local users = {}
		        for seat = 1, self.RequiredPlayerCount do
		            if self.userIdBySeat[seat] == nil then return {} end
		            users[seat] = self.userIdBySeat[seat]
		        end
		        return users
	end

	method table BuildRequiredPlayers()
		        local players = {}
		        for seat = 1, self.RequiredPlayerCount do players[seat] = self.playerEntityBySeat[seat] end
		        return players
	end

	method boolean AreAllPlayersReplaying()
		if self._T.FinishedWithAI or self:HasAISeat() then return false end
		for seat = 1, self.RequiredPlayerCount do
			local userId = self.userIdBySeat[seat]
			if userId == nil or self.finishDecisionByUserId[userId] ~= "Replay" then return false end
		end
		return true
	end

	method table BuildWinsSnapshot()
		        local wins = {}
		        for seat = 1, self.RequiredPlayerCount do wins[seat] = self.winsBySeat[seat] or 0 end
		        return wins
	end

	method integer FindOpenSeat()
		        for seat = 1, self.RequiredPlayerCount do
		            if self.userIdBySeat[seat] == nil then return seat end
		        end
		        return 0
	end

	@ExecSpace("ServerOnly")
	method any AttachBridge(Entity playerEntity, string userId, integer seat, string role)
		        local bridge = playerEntity:GetComponent("script.LexioPlayerBridge")
		        if bridge == nil then bridge = playerEntity:AddComponent("script.LexioPlayerBridge") end
		        if bridge == nil then return nil end
		        bridge:BindServer(self.SessionEntity, self.Entity, playerEntity, userId, seat, role)
		        self.bridgeByUserId[userId] = bridge

		        -- Test-only controls are runtime-attached on map01 and absent from DefaultPlayer.model.
		        local controls = playerEntity:GetComponent("script.LexioManualTestControls")
		        if controls == nil then playerEntity:AddComponent("script.LexioManualTestControls") end
		        return bridge
	end

	@ExecSpace("ServerOnly")
	method boolean RegisterPlayer(Entity playerEntity, string userId)
		        if playerEntity == nil or not isvalid(playerEntity) then return false end
		        if playerEntity.PlayerComponent == nil then return false end
		        if playerEntity.PlayerComponent.UserId ~= userId then return false end
		        if playerEntity.CurrentMap ~= self.Entity.CurrentMap then return false end
		        self.registrationRetryByUserId[userId] = nil

		        local existingSeat = self.seatByUserId[userId]
		        if existingSeat ~= nil then
		            local existingBridge = self.bridgeByUserId[userId]
		            if self.playerEntityBySeat[existingSeat] == playerEntity and existingBridge ~= nil and isvalid(existingBridge.Entity) then return true end
		            self.playerEntityBySeat[existingSeat] = playerEntity
		            self:AttachBridge(playerEntity, userId, existingSeat, "Player")
		            return true
		        end

		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        local seat = 0
		        if session ~= nil and session.phase == "WaitingPlayers" and not self.startRequested then seat = self:FindOpenSeat() end
		        if seat == 0 then
		            self.spectatorByUserId[userId] = true
		            self:AttachBridge(playerEntity, userId, 0, "Spectator")
		            log("[LexioSessionCoordinator] SPECTATOR userId=" .. userId)
		            return true
		        end

		        self.userIdBySeat[seat] = userId
		        self.seatByUserId[userId] = seat
		        self.playerEntityBySeat[seat] = playerEntity
		        self.readyBySeat[seat] = false
		        self:AttachBridge(playerEntity, userId, seat, "Player")
		        log("[LexioSessionCoordinator] JOIN userId=" .. userId .. " seat=" .. tostring(seat))
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean RegisterPlayerEntity(Entity playerEntity)
		        if playerEntity == nil or not isvalid(playerEntity) then return false end
		        if playerEntity.PlayerComponent == nil then return false end
		        local userId = playerEntity.PlayerComponent.UserId
		        if userId == nil or userId == "" then return false end
		        if playerEntity.CurrentMap ~= self.Entity.CurrentMap or playerEntity.CurrentMapName ~= "map01" then return false end
		        return self:RegisterPlayer(playerEntity, userId)
	end

	@ExecSpace("ServerOnly")
	method boolean RegisterTablePlayer(Entity playerEntity, string userId, string tableId, integer seatIndex, string chairName)
		        if self.TableId == "" or self.TableId ~= tableId then return false end
		        if seatIndex < 1 or seatIndex > self.RequiredPlayerCount then return false end
		        if playerEntity == nil or not isvalid(playerEntity) or playerEntity.PlayerComponent == nil then return false end
		        if playerEntity.PlayerComponent.UserId ~= userId or playerEntity.CurrentMap ~= self.Entity.CurrentMap then return false end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or session.phase ~= "WaitingPlayers" or self.startRequested then return false end
		        local currentSeat = self.seatByUserId[userId]
		        if currentSeat ~= nil and currentSeat ~= seatIndex then return false end
		        local owner = self.userIdBySeat[seatIndex]
		        if owner ~= nil and owner ~= userId then return false end
		        self.userIdBySeat[seatIndex] = userId
		        self._T.DisconnectedSeconds[seatIndex] = nil
		        self._T.AIBySeat[seatIndex] = nil
		        self._T.KickedBySeat[seatIndex] = nil
		        self._T.DisconnectVotes[seatIndex] = nil
		        self._T.SeatNames[seatIndex] = playerEntity.NameTagComponent ~= nil and playerEntity.NameTagComponent.Name or playerEntity.Name
		        self.seatByUserId[userId] = seatIndex
		        self.playerEntityBySeat[seatIndex] = playerEntity
		        self.readyBySeat[seatIndex] = false
		        self.explicitReadyBySeat[seatIndex] = false
		        self.seatedBySeat[seatIndex] = true
		        self.chairBySeat[seatIndex] = chairName
		        self:AttachBridge(playerEntity, userId, seatIndex, "Player")
		        log("[LexioSessionCoordinator] TABLE JOIN table=" .. tableId .. " userId=" .. userId .. " seat=" .. tostring(seatIndex))
		        self:BroadcastSnapshots()
		        self:TryStartGame()
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean ReleaseTablePlayer(string userId, Entity playerEntity, string tableId)
		        if self.TableId ~= tableId then return false end
		        local seat = self.seatByUserId[userId]
		        if seat == nil then return true end
		        if self.playerEntityBySeat[seat] ~= playerEntity and self._T.DisconnectedSeconds[seat] == nil then return false end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session ~= nil and (session.phase == "Playing" or session.phase == "LeadPending") then return false end
		        self:RemovePlayer(userId)
		        if next(self.seatByUserId) == nil and session ~= nil and session.phase == "Finished" then
		            session:ResetSession()
		            self.startRequested = false
		            self.finishedResultsPublished = false
		            self.finishDecisionActive = false
		            self.finishCountdown = 0
		            self._T.ClockVersion = nil
		        end
		        self:BroadcastSnapshots()
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean RegisterTableSpectator(Entity playerEntity, string userId, string tableId)
		        if self.TableId == "" or self.TableId ~= tableId then return false end
		        if playerEntity == nil or not isvalid(playerEntity) or playerEntity.PlayerComponent == nil then return false end
		        if playerEntity.PlayerComponent.UserId ~= userId or playerEntity.CurrentMap ~= self.Entity.CurrentMap then return false end
		        if self.seatByUserId[userId] ~= nil then return false end
		        self.spectatorByUserId[userId] = true
		        self:AttachBridge(playerEntity, userId, 0, "Spectator")
		        local bridge = self.bridgeByUserId[userId]
		        if bridge ~= nil then bridge:PushCurrentSnapshot() end
		        log("[VRF] SPECTATOR JOIN table=" .. tableId .. " userId=" .. userId)
		        return true
	end

	@ExecSpace("ServerOnly")
	method void ReleaseTableSpectator(string userId)
		        if not self.spectatorByUserId[userId] then return end
		        self.spectatorByUserId[userId] = nil
		        self.bridgeByUserId[userId] = nil
		        log("[VRF] SPECTATOR LEAVE table=" .. self.TableId .. " userId=" .. userId)
	end

	@ExecSpace("ServerOnly")
	method void RemovePlayer(string userId)
		        local seat = self.seatByUserId[userId]
		        self.bridgeByUserId[userId] = nil
		        self.spectatorByUserId[userId] = nil
		        if seat == nil then return end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session ~= nil and ((session.phase == "WaitingPlayers" and not self.startRequested) or session.phase == "Finished") then
		            self.userIdBySeat[seat] = nil
		            self.seatByUserId[userId] = nil
		            self.playerEntityBySeat[seat] = nil
		            self.readyBySeat[seat] = false
		            self.explicitReadyBySeat[seat] = false
		            self.seatedBySeat[seat] = false
		            self.chairBySeat[seat] = ""
		            self:CancelStartCountdown("player_left")
		        end
		        log("[LexioSessionCoordinator] LEAVE userId=" .. userId .. " seat=" .. tostring(seat))
	end

	@ExecSpace("ServerOnly")
	method boolean RemovePlayerEntity(Entity playerEntity)
		        if playerEntity == nil or not isvalid(playerEntity) or playerEntity.PlayerComponent == nil then return false end
		        local userId = playerEntity.PlayerComponent.UserId
		        if userId == nil or userId == "" then return false end
		        self.registrationRetryByUserId[userId] = nil
		        self.registrationGenerationByUserId[userId] = (self.registrationGenerationByUserId[userId] or 0) + 1
		        local seat = self.seatByUserId[userId]
		        if seat == nil then return true end
		        if self.playerEntityBySeat[seat] ~= playerEntity then return false end
		        self:RemovePlayer(userId)
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean IsExitPhaseAllowed(string phase)
		        return phase == "WaitingPlayers" or phase == "Finished"
	end

	@ExecSpace("ServerOnly")
	method string GetExitRejectionReason(string userId, Entity playerEntity)
		        local seat = self.seatByUserId[userId]
		        -- Players enter map01 unseated and must still be able to use the exit portal.
		        if seat == nil then return "" end
		        if self.playerEntityBySeat[seat] ~= playerEntity then return "player_mismatch" end
		        if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return "player_mismatch" end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil then return "missing_session" end
		        if session.phase == "Playing" or session.phase == "LeadPending" then return "game_in_progress" end
		        if session.phase == "Finished" and not self.finishedResultsPublished then return "results_pending" end
		        if self:IsExitPhaseAllowed(session.phase) then return "" end
		        return "exit_not_allowed"
	end

	@ExecSpace("ServerOnly")
	method boolean PreparePlayerExit(string userId, Entity playerEntity)
		        if self:GetExitRejectionReason(userId, playerEntity) ~= "" then return false end
		        if self.seatByUserId[userId] == nil then
		            log("[LexioSessionCoordinator] EXIT unseated userId=" .. userId)
		            return true
		        end
		        self:RemovePlayer(userId)
		        self:BroadcastSnapshots()
		        return true
	end

	@ExecSpace("ServerOnly")
	method void MarkReady(string userId, Entity playerEntity)
		        local seat = self.seatByUserId[userId]
		        if seat == nil then return end
		        if self.playerEntityBySeat[seat] ~= playerEntity then return end
		        if playerEntity.PlayerComponent == nil or playerEntity.PlayerComponent.UserId ~= userId then return end
		        if self.readyBySeat[seat] then return end
		        self.readyBySeat[seat] = true
		        log("[LexioSessionCoordinator] CLIENT READY userId=" .. userId .. " seat=" .. tostring(seat))
		        -- WaitingPlayers also has a public lobby snapshot so joined clients can render seats.
		        self:BroadcastSnapshots()
		        self:TryStartGame()
	end

	@ExecSpace("ServerOnly")
	method boolean ActivatePrivateRoom(string roomCode)
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if roomCode == nil or roomCode == "" or session == nil or session.phase ~= "WaitingPlayers" or self.startRequested then return false end
		        self.privateRoomCode = roomCode
		        session:SetPersistentRewardsEligible(false, "private_room")
		        self.explicitReadyRequired = true
		        for seat = 1, self.RequiredPlayerCount do self.explicitReadyBySeat[seat] = false end
		        self:CancelStartCountdown("private_room_activated")
		        log("[VRF] PRIVATE ROOM ACTIVE code=" .. roomCode .. " table=" .. self.TableId .. " capacity=" .. tostring(self.RequiredPlayerCount))
		        self:BroadcastSnapshots()
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean SetPersistentRewardsEligible(boolean eligible, string source)
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or session.phase ~= "WaitingPlayers" or self.startRequested then return false end
		        session:SetPersistentRewardsEligible(eligible, source)
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean DeactivatePrivateRoom(string roomCode)
		        if self.privateRoomCode ~= roomCode or self.startRequested then return false end
		        self:CancelStartCountdown("private_room_closed")
		        self.privateRoomCode = ""
		        self.explicitReadyRequired = false
		        for seat = 1, self.RequiredPlayerCount do self.explicitReadyBySeat[seat] = false end
		        log("[VRF] PRIVATE ROOM CLOSED code=" .. tostring(roomCode) .. " table=" .. self.TableId)
		        self:BroadcastSnapshots()
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean SetPrivateReady(string userId, Entity playerEntity, boolean ready)
		        if not self.explicitReadyRequired or self.privateRoomCode == "" then return false end
		        local seat = self.seatByUserId[userId]
		        if seat == nil or self.playerEntityBySeat[seat] ~= playerEntity then return false end
		        if playerEntity == nil or not isvalid(playerEntity) or playerEntity.PlayerComponent == nil then return false end
		        if playerEntity.PlayerComponent.UserId ~= userId then return false end
		        self.explicitReadyBySeat[seat] = ready
		        -- An authenticated ready click also proves that this client's room UI is loaded.
		        self.readyBySeat[seat] = true
		        if not ready then self:CancelStartCountdown("player_unready") end
		        log("[VRF] PRIVATE READY code=" .. self.privateRoomCode .. " seat=" .. tostring(seat) .. " ready=" .. tostring(ready))
		        self:BroadcastSnapshots()
		        self:TryStartGame()
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean CanStartFromSeats()
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil or session.phase ~= "WaitingPlayers" or self.startRequested then return false end
		        for seat = 1, self.RequiredPlayerCount do
		            if self.userIdBySeat[seat] == nil or not self.readyBySeat[seat] or not self.seatedBySeat[seat] then return false end
		            if self.explicitReadyRequired and not self.explicitReadyBySeat[seat] then return false end
		            if self.chairBySeat[seat] == nil or self.chairBySeat[seat] == "" then return false end
		        end
		        return true
	end

	@ExecSpace("ServerOnly")
	method void CancelStartCountdown(string reason)
		        if not self.startCountdownActive then return end
		        self.startCountdownActive = false
		        self.startCountdown = 0
		        self.startCountdownSecond = -1
		        log("[LexioSessionCoordinator] START COUNTDOWN CANCEL reason=" .. tostring(reason))
		        self:BroadcastSnapshots()
	end

	@ExecSpace("ServerOnly")
	method boolean SetSeatState(string userId, Entity playerEntity, boolean seated, string chairName)
		        local seat = self.seatByUserId[userId]
		        if seat == nil or self.playerEntityBySeat[seat] ~= playerEntity then return false end
		        if playerEntity == nil or not isvalid(playerEntity) or playerEntity.PlayerComponent == nil then return false end
		        if playerEntity.PlayerComponent.UserId ~= userId or playerEntity.CurrentMap ~= self.Entity.CurrentMap then return false end
		        if seated then
		            if chairName ~= "LexioChair1" and chairName ~= "LexioChair2" and chairName ~= "LexioChair3" then return false end
		            for otherSeat = 1, self.RequiredPlayerCount do
		                if otherSeat ~= seat and self.seatedBySeat[otherSeat] and self.chairBySeat[otherSeat] == chairName then return false end
		            end
		            self.seatedBySeat[seat] = true
		            self.chairBySeat[seat] = chairName
		            log("[LexioSessionCoordinator] SEATED userId=" .. userId .. " seat=" .. tostring(seat) .. " chair=" .. chairName)
		        else
		            self.seatedBySeat[seat] = false
		            self.chairBySeat[seat] = ""
		            log("[LexioSessionCoordinator] STOOD userId=" .. userId .. " seat=" .. tostring(seat))
		            self:CancelStartCountdown("player_stood")
		        end
		        self:BroadcastSnapshots()
		        self:TryStartGame()
		        return true
	end

	@ExecSpace("ServerOnly")
	method void TryStartGame()
		        if self.Entity.CurrentMapName == "map01" and self.TableId == "" then return end
		        if self.startCountdownActive or not self:CanStartFromSeats() then return end
		        self.startCountdownActive = true
		        self.startCountdown = 3
		        self.startCountdownSecond = 3
		        log("[LexioSessionCoordinator] START COUNTDOWN begin seconds=3")
		        self:BroadcastSnapshots()
	end

	@ExecSpace("ServerOnly")
	method void CompleteStartCountdown()
		        -- Clear the previous finished-room lifecycle before starting a newly occupied table.
		        if not self.startCountdownActive or not self:CanStartFromSeats() then return end
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil then return end
		        self.startCountdownActive = false
		        self.startCountdown = 0
		        self.startCountdownSecond = -1
		        -- Lock before invoking StartGame so the countdown cannot complete twice.
		        self.startRequested = true
		        local users = self:BuildRequiredUsers()
		        self.finishReturnStarted = false
		        self.finishedResultsPublished = false
		        self.finishDecisionActive = false
		        local result = session:StartGame(users, nil)
		        log("[LexioSessionCoordinator] START invoked ok=" .. tostring(result.ok) .. " reason=" .. result.reason)
		        if result.ok then self:BroadcastSnapshots() end
	end

	@ExecSpace("ServerOnly")
	method void BroadcastSnapshots()
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session ~= nil and session.phase == "Finished" then
		            self.finishedResultsPublished = true
		            if not self.finishDecisionActive and not self.finishReturnStarted then self:BeginFinishedDecision() end
		        end
		        for _, bridge in pairs(self.bridgeByUserId) do
		            if bridge ~= nil and isvalid(bridge.Entity) then bridge:PushCurrentSnapshot() end
		        end
	end

	@ExecSpace("ServerOnly")
	method table BuildClientPublicSnapshot()
		        local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		        if session == nil then return nil end
		        local snapshot = nil
		        if session.phase == "WaitingPlayers" then
		            snapshot = {
		                phase = "WaitingPlayers",
		                currentPlayerIndex = 0,
		                winningPlayerIndex = 0,
		                remainingCounts = { 0, 0, 0 },
		                passed = { false, false, false },
		                lastPlay = {},
		                trickNumber = 0,
		                turnNumber = 0,
		                stateVersion = session.stateVersion,
		                winnerIndex = 0
		            }
		        else
		            snapshot = session:BuildPublicSnapshot()
		        end
		        local seatNames = {}
		        local seatUserIds = {}
		        for seat = 1, self.RequiredPlayerCount do
		            local player = self.playerEntityBySeat[seat]
		            seatUserIds[seat] = self.userIdBySeat[seat] or ""
		            if player ~= nil and isvalid(player) then
		                local nickname = player.Name
		                if player.NameTagComponent ~= nil and player.NameTagComponent.Name ~= "" then
		                    nickname = player.NameTagComponent.Name
		                end
		                seatNames[seat] = nickname
		            end
		        end
		        snapshot.seatNames = seatNames
		        snapshot.disconnectedSeconds = {}
		        snapshot.disconnectGenerations = {}
		        snapshot.disconnectVoteCounts = {}
		        snapshot.disconnectNoCounts = {}
		        snapshot.disconnectVoterCount = self:GetDisconnectBallotCounts().total
		        snapshot.disconnectVoteSecondsRemaining = math.ceil(self._T.DisconnectBallotRemaining or 30)
		        snapshot.tableId = self.TableId
		        snapshot.disconnectVoteThresholds = {}
		        snapshot.aiBySeat = {}
		        snapshot.kickedBySeat = {}
		        for seat = 1, self.RequiredPlayerCount do
		            if seatNames[seat] == nil then seatNames[seat] = self._T.SeatNames[seat] end
		            snapshot.disconnectedSeconds[seat] = self._T.DisconnectedSeconds[seat] ~= nil and math.floor(self._T.DisconnectedSeconds[seat]) or -1
		            snapshot.disconnectGenerations[seat] = self._T.DisconnectGeneration[seat] or 0
		            snapshot.aiBySeat[seat] = self._T.AIBySeat[seat] == true
		            snapshot.kickedBySeat[seat] = self._T.KickedBySeat[seat] == true
		            snapshot.disconnectVoteThresholds[seat] = self:GetDisconnectVoteThreshold(seat)
		            local ballot = self:GetDisconnectBallotCounts()
		            snapshot.disconnectVoteCounts[seat] = ballot.yes
		            snapshot.disconnectNoCounts[seat] = ballot.no
		        end
		        snapshot.seatUserIds = seatUserIds
		        snapshot.hasCurrentPlay = session.currentPlay ~= nil
		        snapshot.turnSecondsRemaining = self._T.TurnSecondsRemaining or 15
		        snapshot.connectionPaused = self:HasPendingDisconnect()
		        snapshot.finishedWithAI = self._T.FinishedWithAI == true
		        snapshot.finishGeneration = self.finishGeneration
		        snapshot.finishCountdown = math.ceil(self.finishCountdown)
		        snapshot.finishReplayCount = 0
		        snapshot.finishReplayBySeat = {}
		        for seat = 1, self.RequiredPlayerCount do
		            local userId = self.userIdBySeat[seat]
		            snapshot.finishReplayBySeat[seat] = not self._T.FinishedWithAI and userId ~= nil and self.finishDecisionByUserId[userId] == "Replay"
		        end
		        for seat = 1, self.RequiredPlayerCount do if snapshot.finishReplayBySeat[seat] then snapshot.finishReplayCount = snapshot.finishReplayCount + 1 end end
		        snapshot.winsBySeat = self:BuildWinsSnapshot()
		        snapshot.playerCount = self.RequiredPlayerCount
		        snapshot.privateRoomCode = self.privateRoomCode
		        snapshot.explicitReadyRequired = self.explicitReadyRequired
		        snapshot.explicitReadyBySeat = self.explicitReadyBySeat
		        snapshot.startCountdown = self.startCountdownActive and math.ceil(self.startCountdown) or 0
		        return snapshot
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		        if self.TableId ~= "" then return end
		        local playerEntity = _UserService:GetUserEntityByUserId(event.UserId)
		        if self:RegisterPlayer(playerEntity, event.UserId) then return end
		        self:StartRegistrationRetry(event.UserId)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserLeaveEvent(UserLeaveEvent event)
		        if self.TableId ~= "" then return end
		        self.registrationRetryByUserId[event.UserId] = nil
		        self.registrationGenerationByUserId[event.UserId] = (self.registrationGenerationByUserId[event.UserId] or 0) + 1
		        self:RemovePlayer(event.UserId)
	end


	@ExecSpace("ServerOnly")
	method boolean HasPendingDisconnect()
		for seat = 1, self.RequiredPlayerCount do
			if self._T.DisconnectedSeconds[seat] ~= nil and not self._T.AIBySeat[seat] then return true end
		end
		return false
	end


	@ExecSpace("ServerOnly")
	method table FindAIPlay(integer seat)
		local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		if session == nil or session.currentPlayerIndex ~= seat then return nil end
		local hand = session.hands[seat] or {}
		local previous = session.phase == "Playing" and session.currentPlay or nil
		local count = previous ~= nil and previous.count or 1
		if (count ~= 1 and count ~= 2 and count ~= 3 and count ~= 5) or #hand < count then return nil end
		local indices = {}
		for index = 1, count do indices[index] = index end
		local best = nil
		local bestIds = nil
		-- Enumerate only the required size (at most 792 candidates from a twelve-card hand).
		while true do
			local selected = {}
			local ids = {}
			for index = 1, count do
				local tile = hand[indices[index]]
				table.insert(selected, tile)
				table.insert(ids, tile.id)
			end
			local play = _LexioRules:ClassifyPlay(selected, session.playerCount)
			if play.valid and (previous == nil or _LexioRules:ComparePlays(play, previous) > 0) then
				if best == nil or _LexioRules:ComparePlays(play, best) < 0 then
					best = play
					bestIds = ids
				end
			end
			local cursor = count
			while cursor >= 1 and indices[cursor] == #hand - count + cursor do cursor = cursor - 1 end
			if cursor < 1 then break end
			indices[cursor] = indices[cursor] + 1
			for index = cursor + 1, count do indices[index] = indices[index - 1] + 1 end
		end
		log("[VRF] AI RESPONSE seat=" .. tostring(seat) .. " kind=" .. tostring(best ~= nil and best.kind or "pass"))
		return bestIds
	end


	@ExecSpace("ServerOnly")
	method void ResetEmptyTable()
		local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		if session ~= nil then session:ResetSession() end
		self.startRequested = false
		self:CancelStartCountdown("empty_room")
		for seat = 1, self.RequiredPlayerCount do
			local userId = self.userIdBySeat[seat]
			if userId ~= nil then self:RemovePlayer(userId) end
			self.winsBySeat[seat] = 0
		end
		self.privateRoomCode = ""
		self.explicitReadyRequired = false
		self.registrationRetryByUserId = {}
		self.registrationGenerationByUserId = {}
		self.finishDecisionByUserId = {}
		self.finishDecisionActive = false
		self.finishReturnStarted = false
		self.finishedResultsPublished = false
		self.finishCountdown = 0
		self.finishGeneration = self.finishGeneration + 1
		self._T.FinishedWithAI = false
		self._T.DisconnectedSeconds = {}
		self._T.DisconnectGeneration = {}
		self._T.DisconnectVotes = {}
		self._T.DisconnectBallotVotes = {}
		self._T.DisconnectBallotGeneration = (self._T.DisconnectBallotGeneration or 0) + 1
		self._T.SuspendedPlayers = {}
		self._T.AIBySeat = {}
		self._T.KickedBySeat = {}
		self._T.SeatNames = {}
		self._T.ClockVersion = nil
		self._T.TurnSecondsRemaining = 0
		self._T.TurnCountdown = 0
		log("[VRF] EMPTY TABLE reset=true table=" .. self.TableId)
	end


	@ExecSpace("ServerOnly")
	method boolean HasAISeat()
		for seat = 1, self.RequiredPlayerCount do if self._T.AIBySeat[seat] then return true end end
		return false
	end


	@ExecSpace("ServerOnly")
	method boolean ReleaseFinishedParticipant(string userId, Entity player)
		local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		local seat = registry ~= nil and registry.seatByUserId[userId] or nil
		if seat == nil or seat.tableId ~= self.TableId then return false end
		local released = false
		if registry.privateRoomCodeByUserId[userId] ~= nil then released = registry:LeavePrivateRoom(userId, "finished_return")
		else released = registry:ReleasePlayer(userId, "finished_return") end
		if released and player ~= nil and isvalid(player) and player.CurrentMap == self.Entity.CurrentMap then
			local controls = player:GetComponent("script.LexioManualTestControls")
			if controls ~= nil then controls:ShowFinishedLobby(userId) end
		end
		return released
	end


	@ExecSpace("ServerOnly")
	method void ResetDisconnectBallot()
		self._T.DisconnectBallotGeneration = (self._T.DisconnectBallotGeneration or 0) + 1
		self._T.DisconnectBallotVotes = {}
		self._T.DisconnectBallotRemaining = 30
		for seat = 1, self.RequiredPlayerCount do
			if self._T.DisconnectedSeconds[seat] ~= nil and not self._T.AIBySeat[seat] and not self._T.KickedBySeat[seat] then
				self._T.DisconnectGeneration[seat] = self._T.DisconnectBallotGeneration
				self._T.DisconnectVotes[seat] = self._T.DisconnectBallotVotes
			end
		end
	end

	@ExecSpace("ServerOnly")
	method table GetDisconnectBallotCounts()
		local total = 0
		local yes = 0
		local no = 0
		for seat = 1, self.RequiredPlayerCount do
			local player = self.playerEntityBySeat[seat]
			if not self._T.AIBySeat[seat] and player ~= nil and isvalid(player) and player.CurrentMap == self.Entity.CurrentMap then
				total = total + 1
				local vote = (self._T.DisconnectBallotVotes or {})[self.userIdBySeat[seat]]
				if vote == true then yes = yes + 1 elseif vote == false then no = no + 1 end
			end
		end
		return { total = total, yes = yes, no = no, required = math.floor(total / 2) + 1 }
	end

	@ExecSpace("ServerOnly")
	method void AbortRoomForRejectedAI()
		local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		local users = self:BuildRequiredUsers()
		local players = {}
		if registry ~= nil then for _, userId in pairs(users) do players[userId] = registry.playerByUserId[userId] end end
		local session = self.SessionEntity:GetComponent("script.LexioGameSession")
		if session ~= nil then session:ResetSession() end
		self.startRequested = false
		self.finishDecisionActive = false
		self.finishReturnStarted = true
		for seat = 1, self.RequiredPlayerCount do
			local userId = users[seat]
			if userId ~= nil and registry ~= nil then
				self:ReleaseFinishedParticipant(userId, players[userId])
				registry:ReleaseReplacedSeat(userId, self.TableId, seat)
			end
		end
		self:ResetEmptyTable()
		log("[VRF] AI CONTINUE rejected room_closed=true table=" .. self.TableId)
	end


	@ExecSpace("ServerOnly")
	method void ResolveDisconnectBallotTimeout()
		self._T.DisconnectBallotVotes = self._T.DisconnectBallotVotes or {}
		for seat = 1, self.RequiredPlayerCount do
			local player = self.playerEntityBySeat[seat]
			local userId = self.userIdBySeat[seat]
			if userId ~= nil and not self._T.AIBySeat[seat] and player ~= nil and isvalid(player) and player.CurrentMap == self.Entity.CurrentMap and self._T.DisconnectBallotVotes[userId] == nil then self._T.DisconnectBallotVotes[userId] = false end
		end
		local votes = self:GetDisconnectBallotCounts()
		self._T.LastDisconnectBallotResult = votes
		log("[VRF] AI VOTE timeout yes=" .. tostring(votes.yes) .. " no=" .. tostring(votes.no) .. " total=" .. tostring(votes.total))
		if votes.yes >= votes.required then
			for seat = 1, self.RequiredPlayerCount do
				if self._T.DisconnectedSeconds[seat] ~= nil and not self._T.KickedBySeat[seat] and not self._T.AIBySeat[seat] then self:EnableSeatAI(seat, "continuation_vote") end
			end
			self:BroadcastSnapshots()
		else self:AbortRoomForRejectedAI() end
	end

end
