@Component
script LexioManualTestControls extends Component

	property integer requestSequence = 0

	property string boundTestUserId = ""

	property boolean targetTravelDispatched = false

	property table isolatedFinishTiles = {}

	property integer preparedFinishVersion = -1

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
	local controller = self.Entity.PlayerControllerComponent
	if controller ~= nil then
		controller:RemoveActionKey(KeyboardKey.Space)
		controller:RemoveAllActionKeyByActionName("Jump")
		controller:SetActionKey(KeyboardKey.LeftAlt, "Jump")
		controller:SetActionKey(KeyboardKey.RightAlt, "Jump")
		controller:SetActionKey(KeyboardKey.Space, "Interaction")
		log("[VRF] INPUT REMAP jump=LeftAlt|RightAlt interact=Space")
	end

		        self._T.IsSeated = false
		        self._T.SeatChairName = ""
		        self._T.IsQueued = false
		        self._T.QueuePosition = 0
		        self._T.QueueRequired = 0
		        self._T.MatchMenuOpen = false
		        self._T.ReturnToMatchMenuPending = false
		        self._T.PrivateRoomSnapshot = nil
		        self._T.PrivateRoomError = ""
		        self._T.PrivateRoomList = {}
		        self._T.ShopSnapshot = nil
		        self._T.ShopSequence = 0
		        self._T.LastShopResult = nil
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if _UserService.LocalPlayer ~= self.Entity or self:IsSeated() or self._T.ReconnectOnly == true or not self:IsInLexioGameRoom() then return end
		self._T.ResumeElapsed = (self._T.ResumeElapsed or 0) + delta
		if self._T.ResumeElapsed < 2 then return end
		self._T.ResumeElapsed = 0
		self:RequestResumeGame(false)
	end

	@ExecSpace("Server")
	method void RequestResumeGame(boolean explicitRequest)
		if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		local map = self.Entity.CurrentMap
		local host = map ~= nil and map:GetChildByName("LexioManualSessionHost") or nil
		local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		local accepted = registry ~= nil and registry:ReconnectPlayer(senderUserId, self.Entity)
		if not accepted and explicitRequest then self:ShowFinishedLobby(senderUserId) end
	end

	@ExecSpace("Client")
	method void ApplyResumedGame(table roomSnapshot, string chairName)
		self._T.ReconnectOnly = false
		self._T.IsSeated = true
		self._T.IsQueued = false
		self._T.SeatChairName = chairName
		self._T.PrivateRoomSnapshot = roomSnapshot
		self._T.PrivateRoomError = ""
		_LexioPlayUIController:SetStaticLobbyOpen(true)
		log("[VRF] RECONNECT UI restored=true")
	end

	@ExecSpace("ClientOnly")
	method boolean IsInLexioGameRoom()
		        if self.Entity.CurrentMap == nil then return false end
		        if self.Entity.CurrentMapName == "map01" then return true end
		        return self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost") ~= nil
	end

	@ExecSpace("Server")
	method void RequestRoomChat(string message)
		-- Authenticates and routes text only to members of the sender's authoritative table.
		if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		if message == nil or message == "" or #message > 480 then return end
		local now = _UtilLogic.ElapsedSeconds
		if self._T.LastRoomChatTime ~= nil and now - self._T.LastRoomChatTime < 0.7 then return end
		local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		local seat = registry ~= nil and registry.seatByUserId[senderUserId] or nil
		if seat == nil then
			log_warning("[VRF] ROOM CHAT rejected missing_seat user=" .. senderUserId)
			return
		end
		message = self:FilterRoomChat(message)
		self._T.LastRoomChatTime = now
		log("[VRF] ROOM CHAT send table=" .. seat.tableId .. " user=" .. senderUserId)
		local nickname = self:FilterRoomChat(self.Entity.NameTagComponent ~= nil and self.Entity.NameTagComponent.Name or "플레이어")
		for userId, memberSeat in pairs(registry.seatByUserId) do
			if memberSeat.tableId == seat.tableId then
				local player = registry.playerByUserId[userId]
				local controls = player ~= nil and player:GetComponent("script.LexioManualTestControls") or nil
				if controls ~= nil then controls:ReceiveRoomChat(senderUserId, nickname, message, userId) end
			end
		end
	end

	@ExecSpace("Client")
	method void ReceiveRoomChat(string speakerUserId, string nickname, string message)
		-- Keeps a bounded local history of messages delivered by the room server.
		log("[VRF] ROOM CHAT received speaker=" .. speakerUserId)
		self._T.RoomChatLines = self._T.RoomChatLines or {}
		table.insert(self._T.RoomChatLines, nickname .. ": " .. message)
		while #self._T.RoomChatLines > 6 do table.remove(self._T.RoomChatLines, 1) end
		self._T.RoomChatBubbles = self._T.RoomChatBubbles or {}
		self._T.RoomChatBubbles[speakerUserId] = { text = message, remaining = 5 }
	end

	@ExecSpace("ClientOnly")
	method void ToggleAutoQueue()
		        if not self:IsInLexioGameRoom() or self:IsSeated() then return end
		        if self._T.IsQueued then
		            self:RequestAutoQueue(false, self._T.QueueRequired or 0)
		        else
		            self._T.MatchMenuOpen = not (self._T.MatchMenuOpen == true)
		        end
	end

	@ExecSpace("ClientOnly")
	method void OpenAutoQueueMenu()
		        if not self:IsInLexioGameRoom() or self:IsSeated() or self._T.IsQueued then return end
		        self._T.QueueError = ""
		        self._T.MatchMenuOpen = true
		        log("[VRF] MATCH SIZE MENU open=true")
	end

	@ExecSpace("ClientOnly")
	method void ChooseAutoQueueSize(integer required)
		        if required ~= 0 and required ~= 3 and required ~= 4 and required ~= 5 then return end
		        if not self:IsInLexioGameRoom() or self:IsSeated() or self._T.IsQueued then return end
		        self._T.QueueError = ""
		        self._T.MatchMenuOpen = false
		        self._T.QueueRequired = required
		        self:RequestAutoQueue(true, required)
	end

	@ExecSpace("ClientOnly")
	method void ReturnToAutoQueueMenu()
		        if not self:IsInLexioGameRoom() or self:IsSeated() or not self._T.IsQueued then return end
		        self._T.ReturnToMatchMenuPending = true
		        self:RequestAutoQueue(false, self._T.QueueRequired or 0)
	end

	@ExecSpace("ClientOnly")
	method void CreatePrivateRoom(string title, integer capacity, string password)
		        -- Reports blocked requests so the creation modal never fails silently.
		        if not self:IsInLexioGameRoom() then self._T.PrivateRoomError = "registry_unavailable" return end
		        if self:IsSeated() then self._T.PrivateRoomError = "already_in_room" return end
		        if self._T.IsQueued then self._T.PrivateRoomError = "already_queued" return end
		        self._T.PrivateRoomError = "creating"
		        self:RequestCreatePrivateRoom(title, capacity, password)
	end

	@ExecSpace("Server")
	method void RequestEnterStaticLobby()
		-- Places the authenticated player in the existing session map behind the static UI.
		if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		if self.Entity.CurrentMapName == "map01" then return end
		local source = self.Entity.CurrentMapName
		if source ~= "TileMapTemplate" and source ~= "boardgame_cafe" then return end
		_TeleportService:TeleportToMapPosition(self.Entity, Vector3(0, 0, 0), "map01")
		log("[VRF] STATIC LOBBY session map requested user=" .. senderUserId)
	end

	@ExecSpace("ClientOnly")
	method void JoinPrivateRoom(string code, string password)
		        if not self:IsInLexioGameRoom() or self:IsSeated() or self._T.IsQueued then return end
		        self:RequestJoinPrivateRoom(code, password)
	end

	@ExecSpace("ClientOnly")
	method void RefreshPrivateRooms()
		        if not self:IsInLexioGameRoom() then return end
		        self:RequestPrivateRoomList()
	end

	@ExecSpace("ClientOnly")
	method void TogglePrivateRoomReady()
		        local snapshot = self._T.PrivateRoomSnapshot
		        if snapshot == nil or snapshot.members == nil then return end
		        local localUserId = self.Entity.PlayerComponent ~= nil and self.Entity.PlayerComponent.UserId or ""
		        local currentReady = false
		        for _, roomMember in ipairs(snapshot.members) do if roomMember.userId == localUserId then currentReady = roomMember.ready == true end end
		        self:RequestSetPrivateRoomReady(not currentReady)
	end

	@ExecSpace("ClientOnly")
	method void LeavePrivateRoom()
		        if self._T.PrivateRoomSnapshot == nil then return end
		        self:RequestLeavePrivateRoom()
	end

	@ExecSpace("Server")
	method void RequestCreatePrivateRoom(string title, integer capacity, string password)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		        local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		        if registry == nil then self:ApplyPrivateRoomResult(false, "registry_unavailable", nil) return end
		        local result = registry:CreatePrivateRoom(senderUserId, self.Entity, title, capacity, password)
		        self:ApplyPrivateRoomResult(result.ok, result.reason, result.room)
	end

	@ExecSpace("Server")
	method void RequestJoinPrivateRoom(string code, string password)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		        local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		        if registry == nil then self:ApplyPrivateRoomResult(false, "registry_unavailable", nil) return end
		        local result = registry:JoinPrivateRoom(senderUserId, self.Entity, code, password)
		        self:ApplyPrivateRoomResult(result.ok, result.reason, result.room)
	end

	@ExecSpace("Server")
	method void RequestPrivateRoomList()
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		        local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		        self:ApplyPrivateRoomList(registry ~= nil and registry:ListPrivateRooms() or {})
	end

	@ExecSpace("Server")
	method void RequestSetPrivateRoomReady(boolean ready)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		        local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		        if registry == nil then return end
		        local accepted = registry:SetPrivateRoomReady(senderUserId, self.Entity, ready)
		        local code = registry.privateRoomCodeByUserId[senderUserId]
		        local room = code ~= nil and registry.privateRoomByCode[code] or nil
		        self:ApplyPrivateRoomResult(accepted, accepted and "" or "ready_rejected", registry:BuildPrivateRoomSnapshot(room, senderUserId))
	end

	@ExecSpace("Server")
	method void RequestLeavePrivateRoom()
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		        local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		        if registry == nil then return end
		        local accepted = registry:LeavePrivateRoom(senderUserId, "private_room_leave")
		        self:ApplyPrivateRoomResult(accepted, accepted and "" or "leave_rejected", nil)
	end

	@ExecSpace("Client")
	method void ApplyPrivateRoomResult(boolean accepted, string reason, table snapshot)
		        -- Closes the modal only after the server accepts creation or entry.
		        self._T.PrivateRoomError = accepted and "" or reason
		        if accepted and snapshot ~= nil then _LexioPlayUIController:SetCreatePopupVisible(false) end
		        if accepted then self._T.PrivateRoomSnapshot = snapshot end
		        if snapshot == nil and accepted then self:ClearRoomClientState() end
		        log("[VRF] PRIVATE ROOM CLIENT accepted=" .. tostring(accepted) .. " reason=" .. tostring(reason) .. " code=" .. tostring(snapshot ~= nil and snapshot.code or ""))
	end

	@ExecSpace("Client")
	method void ApplyPrivateRoomSnapshot(table snapshot)
		        self._T.PrivateRoomSnapshot = snapshot
		        self._T.PrivateRoomError = ""
		        log("[VRF] PRIVATE ROOM SYNC code=" .. tostring(snapshot ~= nil and snapshot.code or "") .. " members=" .. tostring(snapshot ~= nil and snapshot.members ~= nil and #snapshot.members or 0))
	end

	@ExecSpace("Client")
	method void ApplyPrivateRoomList(table rooms)
		        self._T.PrivateRoomList = rooms or {}
		        log("[VRF] PRIVATE ROOM LIST count=" .. tostring(#self._T.PrivateRoomList))
	end

	@ExecSpace("Server")
	method void RequestShopSnapshot(string requestId)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        if requestId == nil or requestId == "" or #requestId > 64 then return end
		        self:ApplyShopResult(requestId, true, "snapshot", _LexioRewardService:GetShopSnapshot(senderUserId))
	end

	@ExecSpace("Server")
	method void RequestShopPurchase(string requestId, string itemId)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        if requestId == nil or requestId == "" or #requestId > 64 then return end
		        local result = _LexioRewardService:PurchaseItem(senderUserId, itemId)
		        self:ApplyShopResult(requestId, result.ok, result.reason, result.snapshot or _LexioRewardService:GetShopSnapshot(senderUserId))
	end

	@ExecSpace("Server")
	method void RequestShopEquip(string requestId, string itemId)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        if requestId == nil or requestId == "" or #requestId > 64 then return end
		        local result = _LexioRewardService:EquipItem(senderUserId, self.Entity, itemId)
		        self:ApplyShopResult(requestId, result.ok, result.reason, result.snapshot or _LexioRewardService:GetShopSnapshot(senderUserId))
	end

	@ExecSpace("Server")
	method void RequestShopUnequip(string requestId, string slot)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        if requestId == nil or requestId == "" or #requestId > 64 then return end
		        local result = _LexioRewardService:UnequipSlot(senderUserId, self.Entity, slot)
		        self:ApplyShopResult(requestId, result.ok, result.reason, result.snapshot or _LexioRewardService:GetShopSnapshot(senderUserId))
	end

	@ExecSpace("Client")
	method void ApplyShopResult(string requestId, boolean ok, string reason, table snapshot)
		        self._T.ShopSnapshot = snapshot
		        self._T.LastShopResult = { requestId=requestId, ok=ok, reason=reason }
		        self._T.ShopSequence = (self._T.ShopSequence or 0) + 1
		        log("[VRF] SHOP RESULT requestId=" .. requestId .. " ok=" .. tostring(ok) .. " reason=" .. reason .. " points=" .. tostring(snapshot ~= nil and snapshot.points or 0))
	end

	@ExecSpace("ClientOnly")
	method void RequestSpectate(integer tableNumber)
		        if self.Entity.CurrentMapName ~= "map01" or self:IsSeated() then return end
		        local tableId = tableNumber == 0 and "" or ("table0" .. tostring(tableNumber))
		        self:RequestSpectatorTable(tableId)
	end

	@ExecSpace("Server")
	method void RequestSpectatorTable(string tableId)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        if tableId ~= "" and tableId ~= "table01" and tableId ~= "table02" and tableId ~= "table03" then return end
		        local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		        local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		        if registry == nil then return end
		        local accepted = registry:SetSpectatorTable(senderUserId, self.Entity, tableId)
		        if accepted then self:ApplySpectatorState(tableId) end
	end

	@ExecSpace("Client")
	method void ApplySpectatorState(string tableId)
		        self._T.SpectatorTableId = tableId
		        log("[LexioSpectator] table=" .. (tableId == "" and "none" or tableId))
	end

	@ExecSpace("Server")
	method void RequestAutoQueue(boolean join, integer required)
		if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		if required ~= 0 and required ~= 3 and required ~= 4 and required ~= 5 then return end
		local map = self.Entity.CurrentMap
		local host = map ~= nil and map:GetChildByName("LexioManualSessionHost") or nil
		local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		if registry == nil then self:ApplyQueueError("registry_unavailable", senderUserId) return end
		local accepted = false
		if join then accepted = registry:JoinQueue(senderUserId, self.Entity, required)
		else accepted = registry:CancelQueue(senderUserId) end
		if not accepted then
			self:ApplyQueueError(registry.seatByUserId[senderUserId] ~= nil and "already_in_room" or "queue_rejected", senderUserId)
		elseif not join then self:ApplyQueueState(false, 0, required) end
	end

	@ExecSpace("Client")
	method void ApplyQueueState(boolean queued, integer position, integer required)
		        self._T.QueueError = ""
		        self._T.IsQueued = queued
		        self._T.QueuePosition = position
		        self._T.QueueRequired = required
		        if queued then self._T.MatchMenuOpen = false end
		        if not queued and self._T.ReturnToMatchMenuPending then
		            self._T.ReturnToMatchMenuPending = false
		            self._T.MatchMenuOpen = true
		        end
		        if queued then
		            log("[LexioMatch] QUEUED position=" .. tostring(position) .. "/" .. tostring(required) .. " cancel=Q")
		        else
		            log("[LexioMatch] QUEUE CLEARED")
		        end
	end

	@ExecSpace("Client")
	method void ApplyAutoMatchResult(boolean accepted, string chairName, integer queuePosition)
		        self:ApplyQueueState(false, queuePosition, self._T.QueueRequired or 0)
		        if accepted then self:ApplySeatStateResult(true, true, chairName) end
	end

	@ExecSpace("ClientOnly")
	method boolean IsSeated()
		        return self._T.IsSeated == true
	end

	@ExecSpace("Client")
	method void ForceStandForLobby()
		        self._T.IsSeated = false
		        self._T.SeatChairName = ""
		        local controller = self.Entity.PlayerControllerComponent
		        if controller ~= nil then controller.Enable = true end
		        local state = self.Entity.StateComponent
		        if state ~= nil then state:ChangeState("IDLE") end
		        log("[LexioSeat] FORCE STAND reason=lobby_return")
	end

	@ExecSpace("ClientOnly")
	method void OnMapLeave(Entity leftMap)
		        if leftMap == nil or leftMap.Name ~= "map01" then return end
		        self:RequestReleaseSeat("map_leave")
		        self:ForceStandForLobby()
	end

	@ExecSpace("Client")
	method void ShowFinishedLobby()
		        -- Discard the finished room view and open the public room browser without map travel.
		        self:ClearRoomClientState()
		        _LexioPlayUIController:SetStaticLobbyOpen(true)
		        local entity = _EntityService:GetEntityByPath("/ui/LexioMainMenu/Controller")
		        local menu = entity ~= nil and entity:GetComponent("script.LexioMainMenuController") or nil
		        if menu ~= nil then menu:OpenLobby() end
		        self:RefreshPrivateRooms()
		        log("[VRF] FINISHED LOBBY browserOpened=true")
	end

	@ExecSpace("ClientOnly")
	method void ToggleSeat()
		        if self.Entity.CurrentMapName ~= "map01" then return end
		        if self:IsSeated() then
		            self:RequestReleaseSeat("key_x")
		            return
		        end

		        local nearestChair = nil
		        local nearestTableId = ""
		        local nearestSeatIndex = 0
		        local nearestDistance = 999
		        local playerPosition = self.Entity.TransformComponent.WorldPosition
		        for tableIndex = 1, 3 do
		            local tableNumber = "0" .. tostring(tableIndex)
		            local requiredPlayerCount = tableIndex + 2
		            for seatIndex = 1, requiredPlayerCount do
		                local chair = _EntityService:GetEntityByPath("/maps/map01/LexioTable" .. tableNumber .. "Chair" .. tostring(seatIndex))
		                if chair ~= nil and isvalid(chair) then
		                    local chairPosition = chair.TransformComponent.WorldPosition
		                    local distance = Vector2.Distance(Vector2(playerPosition.x, playerPosition.y), Vector2(chairPosition.x, chairPosition.y))
		                    if distance < nearestDistance then
		                        nearestChair = chair
		                        nearestTableId = "table" .. tableNumber
		                        nearestSeatIndex = seatIndex
		                        nearestDistance = distance
		                    end
		                end
		            end
		        end
		        if nearestChair == nil or nearestDistance > 1.2 then
		            log("[LexioSeat] REJECT reason=too_far distance=" .. tostring(nearestDistance))
		            return
		        end
		        self:RequestSeatState(nearestTableId, nearestSeatIndex, nearestChair.Name)
	end

	@ExecSpace("Server")
	method void RequestSeatState(string tableId, integer seatIndex, string chairName)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        if self.Entity.CurrentMapName ~= "map01" then return end
		        local host = self.Entity.CurrentMap:GetChildByName("LexioManualSessionHost")
		        local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		        if registry == nil then self:ApplySeatStateResult(false, false, "") return end
		        local accepted = registry:TryReserveSeat(senderUserId, self.Entity, tableId, seatIndex, chairName)
		        self:ApplySeatStateResult(accepted, accepted, accepted and chairName or "")
	end

	@ExecSpace("Server")
	method void RequestReleaseSeat(string reason)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		        local host = _EntityService:GetEntityByPath("/maps/map01/LexioManualSessionHost")
		        local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		        local accepted = registry ~= nil and registry:ReleasePlayer(senderUserId, reason)
		        self:ApplySeatStateResult(accepted, false, "")
	end

	@ExecSpace("Client")
	method void ApplySeatStateResult(boolean accepted, boolean seated, string chairName)
		        if not accepted then
		            log("[LexioSeat] REJECT reason=server_validation")
		            return
		        end
		        local controller = self.Entity.PlayerControllerComponent
		        local state = self.Entity.StateComponent
		        self._T.IsSeated = seated
		        self._T.SeatChairName = seated and chairName or ""
		        if seated then
		            if string.sub(chairName, 1, 13) == "LexioSession_" then
		                if controller ~= nil then controller.Enable = false end
		                log("[VRF] STATIC SEAT assigned=" .. chairName)
		                return
		            end
		            local chair = _EntityService:GetEntityByPath("/maps/map01/" .. chairName)
		            if chair == nil then return end
		            local chairPosition = chair.TransformComponent.WorldPosition
		            if controller ~= nil then controller.Enable = false end
		            local body = self.Entity.KinematicbodyComponent
		            if body ~= nil then body:SetWorldPosition(Vector2(chairPosition.x, chairPosition.y + 0.15)) end
		            if state ~= nil then state:ChangeState("SIT") end
		            log("[LexioSeat] SIT chair=" .. chairName .. " key=X")
		        else
		            if controller ~= nil then controller.Enable = true end
		            if state ~= nil then state:ChangeState("IDLE") end
		            log("[LexioSeat] STAND")
		        end
	end

	@ExecSpace("ServerOnly")
	method void BindTestUser(string userId)
		        if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= userId then return end
		        self.boundTestUserId = userId
	end

	@ExecSpace("ServerOnly")
	method boolean DispatchTargetTravel(string requestedUserId)
		        if requestedUserId == nil or requestedUserId == "" or #requestedUserId > 32 then return false end
		        if self.targetTravelDispatched then return false end
		        local lobby = _EntityService:GetEntityByPath("/maps/TileMapTemplate")
		        local entrance = _EntityService:GetEntityByPath("/maps/TileMapTemplate/LexioEntrance")
		        local targetPlayer = _UserService:GetUserEntityByUserId(requestedUserId)
		        if lobby == nil or entrance == nil or targetPlayer == nil or not isvalid(targetPlayer) then return false end
		        if targetPlayer.PlayerComponent == nil or targetPlayer.PlayerComponent.UserId ~= requestedUserId then return false end
		        if targetPlayer.CurrentMap ~= lobby or targetPlayer.CurrentMapName ~= "TileMapTemplate" then return false end
		        local targetControls = targetPlayer:GetComponent("script.LexioManualTestControls")
		        local travelBridge = targetPlayer:GetComponent("script.LexioTravelBridge")
		        if targetControls == nil or targetControls.boundTestUserId ~= requestedUserId or travelBridge == nil then return false end
		        if travelBridge.inFlight or travelBridge.cooldownRemaining > 0 then return false end
		        local entrancePosition = entrance.TransformComponent.WorldPosition
		        targetPlayer.TransformComponent.WorldPosition = Vector3(entrancePosition.x, entrancePosition.y, entrancePosition.z)
		        self.targetTravelDispatched = true
		        targetControls:ExecuteTargetTravel(requestedUserId)
		        log("[LexioManualTarget] TRAVEL DISPATCH userId=" .. requestedUserId)
		        return true
	end

	@ExecSpace("Client")
	method void ExecuteTargetTravel()
		        local player = _UserService.LocalPlayer
		        if player == nil or player ~= self.Entity or player.PlayerComponent == nil then return end
		        if player.PlayerComponent.UserId ~= self.boundTestUserId then return end
		        local bridge = player:GetComponent("script.LexioTravelBridge")
		        local entrance = _EntityService:GetEntityByPath("/maps/TileMapTemplate/LexioEntrance")
		        if bridge == nil or entrance == nil or player.CurrentMapName ~= "TileMapTemplate" then return end
		        log("[LexioManualTarget] TRAVEL CLIENT userId=" .. self.boundTestUserId)
		        bridge:RequestTravel("LexioEntrance", "LEXIO_PLAY", player)
	end

	@ExecSpace("ClientOnly")
	method any GetBridge()
		        return self.Entity:GetComponent("script.LexioPlayerBridge")
	end

	@ExecSpace("ClientOnly")
	method string NextRequestId(string action)
		        self.requestSequence = self.requestSequence + 1
		        return action .. "-" .. tostring(self.requestSequence)
	end

	@ExecSpace("ClientOnly")
	method void SubmitTileIds(table tileIds)
		        local bridge = self:GetBridge()
		        local publicSnapshot = bridge ~= nil and bridge:GetMatchedPublicSnapshot() or nil
		        if bridge == nil or publicSnapshot == nil then
		            log_error("[LexioManualTestControls] snapshot unavailable")
		            return
		        end
		        bridge:RequestSubmit(self:NextRequestId("submit"), tileIds, publicSnapshot.stateVersion)
	end

	@ExecSpace("ClientOnly")
	method void SubmitFirstTile()
		        local bridge = self:GetBridge()
		        local privateHand = bridge ~= nil and bridge:GetMatchedPrivateHand() or nil
		        if bridge == nil or privateHand == nil or #privateHand == 0 then
		            log_error("[LexioManualTestControls] private hand unavailable")
		            return
		        end
		        self:SubmitTileIds({ privateHand[1].id })
	end

	@ExecSpace("ClientOnly")
	method void Pass()
		        local bridge = self:GetBridge()
		        local publicSnapshot = bridge ~= nil and bridge:GetMatchedPublicSnapshot() or nil
		        if bridge == nil or publicSnapshot == nil then
		            log_error("[LexioManualTestControls] snapshot unavailable")
		            return
		        end
		        bridge:RequestPass(self:NextRequestId("pass"), publicSnapshot.stateVersion)
	end

	@ExecSpace("ClientOnly")
	method void PrintState()
		        local bridge = self:GetBridge()
		        if bridge == nil then return end
		        local privateHand = bridge:GetMatchedPrivateHand()
		        local publicSnapshot = bridge:GetMatchedPublicSnapshot()
		        local handCount = privateHand ~= nil and #privateHand or 0
		        local version = publicSnapshot ~= nil and publicSnapshot.stateVersion or -1
		        log("[LexioManualTestControls] role=" .. tostring(bridge._T.Role) .. " seat=" .. tostring(bridge._T.Seat) .. " hand=" .. tostring(handCount) .. " version=" .. tostring(version))
	end

	@ExecSpace("ServerOnly")
	method boolean IsAllowedTargetAction(string action)
		        return action == "Ready" or action == "SubmitFirstTile" or action == "Pass" or action == "FinishSubmit"
	end

	@ExecSpace("ServerOnly")
	method integer GetCurrentTurnSeat()
		        local currentMap = self.Entity.CurrentMap
		        if currentMap == nil or currentMap.Name ~= "map01" then return 0 end
		        local host = currentMap:GetChildByName("LexioManualSessionHost")
		        local coordinator = host ~= nil and host:GetComponent("script.LexioSessionCoordinator") or nil
		        local session = host ~= nil and host:GetComponent("script.LexioGameSession") or nil
		        if coordinator == nil or session == nil then return 0 end
		        local seat = session.currentPlayerIndex
		        if seat < 1 or seat > 3 then return 0 end
		        if coordinator.playerEntityBySeat[seat] == nil or coordinator.userIdBySeat[seat] == nil then return 0 end
		        return seat
	end

	@ExecSpace("ServerOnly")
	method boolean PrepareFinishScenario()
		        local currentMap = self.Entity.CurrentMap
		        if currentMap == nil or currentMap.Name ~= "map01" then return false end
		        local host = currentMap:GetChildByName("LexioManualSessionHost")
		        local coordinator = host ~= nil and host:GetComponent("script.LexioSessionCoordinator") or nil
		        local session = host ~= nil and host:GetComponent("script.LexioGameSession") or nil
		        if coordinator == nil or session == nil then return false end
		        if session.phase ~= "Playing" and session.phase ~= "LeadPending" then return false end
		        if coordinator.userIdBySeat[1] == nil or coordinator.userIdBySeat[2] == nil or coordinator.userIdBySeat[3] == nil then return false end
		        if not coordinator.readyBySeat[1] or not coordinator.readyBySeat[2] or not coordinator.readyBySeat[3] then return false end
		        local seat = session.currentPlayerIndex
		        if seat < 1 or seat > 3 then return false end
		        local targetPlayer = coordinator.playerEntityBySeat[seat]
		        local targetUserId = coordinator.userIdBySeat[seat]
		        if targetPlayer == nil or not isvalid(targetPlayer) or targetPlayer.PlayerComponent == nil then return false end
		        if targetPlayer.PlayerComponent.UserId ~= targetUserId or targetPlayer.CurrentMap ~= currentMap then return false end
		        local targetControls = targetPlayer:GetComponent("script.LexioManualTestControls")
		        local hand = session.hands[seat]
		        if targetControls == nil or hand == nil or #hand ~= 12 then return false end
		        local keptTile = hand[1]
		        if keptTile == nil or keptTile.id == nil or session.tilesById[keptTile.id] == nil then return false end
		        local isolated = {}
		        for index = 2, #hand do table.insert(isolated, hand[index]) end
		        -- Test-only isolation: tilesById remains untouched and the removed tiles are not reassigned.
		        targetControls.isolatedFinishTiles = isolated
		        session.hands[seat] = { keptTile }
		        session.phase = "LeadPending"
		        session.currentPlayerIndex = seat
		        session.winningPlayerIndex = seat
		        session.currentPlay = nil
		        session.currentPlayTiles = {}
		        session.lastPublicPlay = {}
		        session.passed = { false, false, false }
		        session.stateVersion = session.stateVersion + 1
		        targetControls.preparedFinishVersion = session.stateVersion
		        coordinator:BroadcastSnapshots()
		        log("[LexioManualFinish] PREPARED seat=" .. tostring(seat) .. " isolated=" .. tostring(#isolated) .. " version=" .. tostring(session.stateVersion))
		        return true
	end

	@ExecSpace("ServerOnly")
	method boolean DispatchFinishSubmit()
		        local seat = self:GetCurrentTurnSeat()
		        if seat == 0 then return false end
		        return self:DispatchSeatAction(seat, "FinishSubmit")
	end

	@ExecSpace("ServerOnly")
	method boolean DispatchSeatAction(integer seat, string action)
		        -- Test-only server entry point. Seat is resolved through authoritative registration;
		        -- no caller-supplied UserId is accepted.
		        if seat < 1 or seat > 3 then return false end
		        if not self:IsAllowedTargetAction(action) then return false end
		        local currentMap = self.Entity.CurrentMap
		        if currentMap == nil or currentMap.Name ~= "map01" then return false end
		        local host = currentMap:GetChildByName("LexioManualSessionHost")
		        if host == nil then return false end
		        local coordinator = host:GetComponent("script.LexioSessionCoordinator")
		        if coordinator == nil then return false end
		        local targetUserId = coordinator.userIdBySeat[seat]
		        local targetPlayer = coordinator.playerEntityBySeat[seat]
		        if targetUserId == nil or targetUserId == "" then return false end
		        if targetPlayer == nil or not isvalid(targetPlayer) then return false end
		        if targetPlayer.PlayerComponent == nil or targetPlayer.PlayerComponent.UserId ~= targetUserId then return false end
		        local targetControls = targetPlayer:GetComponent("script.LexioManualTestControls")
		        if targetControls == nil then return false end
		        log("[LexioManualTarget] DISPATCH seat=" .. tostring(seat) .. " action=" .. action)
		        -- Hidden final parameter targets only the authoritative seat owner's client.
		        targetControls:ExecuteTargetAction(action, targetUserId)
		        return true
	end

	@ExecSpace("Client")
	method void ExecuteTargetAction(string action)
		        -- Runs only one predeclared input path on the selected client. The called Bridge
		        -- still supplies server-assigned senderUserId and performs all ownership checks.
		        local bridge = self:GetBridge()
		        if bridge == nil then return end
		        log("[LexioManualTarget] CLIENT action=" .. action .. " user=" .. tostring(_UserService.LocalPlayer.PlayerComponent.UserId))
		        if action == "Ready" then
		            bridge:NotifyClientReady()
		        elseif action == "SubmitFirstTile" then
		            self:SubmitFirstTile()
		        elseif action == "Pass" then
		            self:Pass()
		        elseif action == "FinishSubmit" then
		            self:SubmitFirstTile()
		        end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleSeatKeyDown(KeyDownEvent event)
		        if event.key == KeyboardKey.UpArrow then
		            local playerPosition = self.Entity.TransformComponent.WorldPosition
		            local portalName = ""
		            if playerPosition.y < -9 then
		                portalName = "LexioElevator1FUp"
		            elseif playerPosition.y < -3 then
		                if playerPosition.x < 0 then portalName = "LexioElevator2FDown"
		                else portalName = "LexioElevator2FUp" end
		            else
		                portalName = "LexioElevator3FDown"
		            end
		            local routeByPortal = {
		                LexioElevator1FUp = "LEXIO_ELEVATOR_1F_UP",
		                LexioElevator2FDown = "LEXIO_ELEVATOR_2F_DOWN",
		                LexioElevator2FUp = "LEXIO_ELEVATOR_2F_UP",
		                LexioElevator3FDown = "LEXIO_ELEVATOR_3F_DOWN"
		            }
		            local bridge = self.Entity:GetComponent("script.LexioTravelBridge")
		            if bridge ~= nil then bridge:RequestTravel(portalName, routeByPortal[portalName], self.Entity) end
		            log("[VRF] ELEVATOR KEY playerRoute=" .. portalName)
		            return
		        end
		        if event.key == KeyboardKey.X then self:ToggleSeat() return end
		        if event.key == KeyboardKey.Q then self:ToggleAutoQueue() end
	end


	@ExecSpace("Server")
	method void RequestSuspendGame()
		if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		local map = self.Entity.CurrentMap
		local host = map ~= nil and map:GetChildByName("LexioManualSessionHost") or nil
		local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		local seat = registry ~= nil and registry.seatByUserId[senderUserId] or nil
		local coordinator = seat ~= nil and registry:GetTableCoordinator(seat.tableId) or nil
		if coordinator == nil or coordinator.playerEntityBySeat[seat.seatIndex] ~= self.Entity then return end
		local session = coordinator.SessionEntity:GetComponent("script.LexioGameSession")
		if session == nil or (session.phase ~= "Playing" and session.phase ~= "LeadPending") then return end
		coordinator._T.SuspendedPlayers = coordinator._T.SuspendedPlayers or {}
		coordinator._T.SuspendedPlayers[seat.seatIndex] = self.Entity
		coordinator:MarkDisconnected(senderUserId)
		self:ShowReconnectOnly(senderUserId)
	end

	@ExecSpace("Client")
	method void ShowReconnectOnly()
		self._T.ReconnectOnly = true
		self._T.IsSeated = false
		self._T.MatchMenuOpen = false
		self._T.ResumeElapsed = 0
		log("[VRF] RECONNECT SCREEN opened=true")
	end


	@ExecSpace("Server")
	method void RequestAbandonGame()
		if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		local map = self.Entity.CurrentMap
		local host = map ~= nil and map:GetChildByName("LexioManualSessionHost") or nil
		local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		local seat = registry ~= nil and registry.seatByUserId[senderUserId] or nil
		if seat == nil then self:ShowFinishedLobby(senderUserId) return end
		local coordinator = registry:GetTableCoordinator(seat.tableId)
		if coordinator == nil or coordinator._T.DisconnectedSeconds[seat.seatIndex] == nil or coordinator._T.KickedBySeat[seat.seatIndex] then return end
		if registry.playerByUserId[senderUserId] ~= self.Entity then return end
		coordinator._T.KickedBySeat[seat.seatIndex] = true
		coordinator:EnableSeatAI(seat.seatIndex, "voluntary_leave")
		registry:DetachReplacedPlayer(senderUserId, seat.tableId, seat.seatIndex)
		coordinator:BroadcastSnapshots()
		log("[VRF] VOLUNTARY LEAVE lobby=true user=" .. senderUserId)
	end


	@ExecSpace("ClientOnly")
	method void ClearRoomClientState()
		self._T.ReconnectOnly = false
		        self:ForceStandForLobby()
		        self._T.PrivateRoomSnapshot = nil
		        self._T.PrivateRoomError = ""
		        self._T.RoomChatLines = {}
		        self._T.RoomChatBubbles = {}
		        local bridge = self.Entity:GetComponent("script.LexioPlayerBridge")
		        if bridge ~= nil then
		            bridge._T.MatchedPublicSnapshot = nil
		            bridge._T.MatchedPrivateHand = nil
		            bridge._T.PrivateByVersion = {}
		            bridge._T.PublicByVersion = {}
		        end
		self._T.IsQueued = false
		self._T.MatchMenuOpen = false
	end


	@ExecSpace("Server")
	method void RequestUpdatePrivateRoomSettings(integer capacity, boolean usePassword, string password)
		if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		local map = self.Entity.CurrentMap
		local host = map ~= nil and map:GetChildByName("LexioManualSessionHost") or nil
		local registry = host ~= nil and host:GetComponent("script.LexioTableRegistry") or nil
		local result = registry ~= nil and registry:UpdatePrivateRoomSettings(senderUserId, self.Entity, capacity, usePassword, password) or { ok = false, reason = "registry_unavailable" }
		self:ApplyRoomSettingsResult(result.ok, result.reason, senderUserId)
	end

	@ExecSpace("Client")
	method void ApplyRoomSettingsResult(boolean accepted, string reason)
		self._T.RoomSettingsError = accepted and "" or reason
		if accepted then _LexioPlayUIController:SetRoomSettingsVisible(false) end
		log("[VRF] ROOM SETTINGS result accepted=" .. tostring(accepted) .. " reason=" .. reason)
	end


	@ExecSpace("Client")
	method void ApplyQueueError(string reason)
		self._T.IsQueued = false
		self._T.QueueError = reason
		self._T.MatchMenuOpen = true
		log("[VRF] QUEUE rejected reason=" .. reason)
	end

	@ExecSpace("ServerOnly")
	method string FilterRoomChat(string message)
		if message == nil then return "" end
		local lowered = string.lower(message)
		local normalized = lowered
		local replacementCount = 0
		-- Remove common invisible separators before checking obfuscated words.
		for _, separator in ipairs({ "​", "‌", "‍", "﻿", "　", " " }) do normalized, replacementCount = string.gsub(normalized, separator, "") end
		normalized, replacementCount = string.gsub(normalized, "[%s%p%c]", "")
		-- Preserve ordinary uses such as '시발점' and '시발역'.
		local korean = normalized
		korean, replacementCount = string.gsub(korean, "시발점", "")
		korean, replacementCount = string.gsub(korean, "시발역", "")
		local terms = { "씨발", "씨빨", "씨팔", "시발", "시빨", "ㅅㅂ", "ㅆㅂ", "좆", "개새끼", "개새기", "씹새", "병신", "ㅂㅅ", "지랄", "미친놈", "미친년" }
		for _, word in ipairs(terms) do
			if string.find(korean, word, 1, true) ~= nil then
				log("[VRF] ROOM CHAT profanity masked=true")
				return "***"
			end
		end
		for _, word in ipairs({ "fuck", "fucking", "fucker", "motherfucker", "shit", "bullshit", "bitch", "asshole" }) do
			local pattern = "%f[%a]" .. word .. "%f[%A]"
			if string.find(lowered, pattern) ~= nil or string.find(normalized, pattern) ~= nil then
				log("[VRF] ROOM CHAT profanity masked=true")
				return "***"
			end
		end
		return message
	end

	@ExecSpace("Server")
	method void RequestExitWorld()
		-- Only the requesting player can leave, without a disciplinary reason.
		if self.Entity.PlayerComponent == nil or self.Entity.PlayerComponent.UserId ~= senderUserId then return end
		if Environment:IsMakerPlay() then
			log("[VRF] WORLD EXIT validated=true makerPreview=true")
			return
		end
		log("[VRF] WORLD EXIT requires platform menu")
	end

end
