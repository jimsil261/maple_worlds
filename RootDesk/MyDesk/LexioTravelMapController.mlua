@Component
script LexioTravelMapController extends Component

	property string ManagedMapName = ""

	property number scanElapsed = 0

	property boolean EnableManualTestHooks = true

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		        log("[LexioTravelMapController] READY map=" .. self.ManagedMapName)
		        self.scanElapsed = 0
		        if self.ManagedMapName == "map01" then self:SpawnFloorPortals() end
		        self:ConfigureExistingPortalKeys()
		        self:AttachCurrentPlayers()
	end

	@ExecSpace("ServerOnly")
	method void ConfigureExistingPortalKeys()
		        local portalNames = {"CafeEntrance", "LexioEntrance", "LexioExit"}
		        for _, portalName in ipairs(portalNames) do
		            local portal = self.Entity.CurrentMap:GetChildByName(portalName)
		            if portal ~= nil and portal.InteractionComponent ~= nil then
		                portal.InteractionComponent.ActionKey = KeyboardKey.UpArrow
		                portal.InteractionComponent.BoxSize = Vector2(0.9, 1.2)
		                log("[LexioTravelMapController] PORTAL_KEY name=" .. portalName .. " key=UpArrow")
		            end
		        end
	end

	@ExecSpace("ServerOnly")
	method void SpawnFloorPortals()
		        self:SpawnFloorPortal("Floor1UpPortal", Vector3(6.8, -12.15, 0), "2층으로 올라가기", "FLOOR_UP")
		        self:SpawnFloorPortal("Floor2DownPortal", Vector3(-6.8, -6.15, 0), "1층으로 내려가기", "FLOOR_DOWN")
		        self:SpawnFloorPortal("Floor2UpPortal", Vector3(6.8, -6.15, 0), "3층으로 올라가기", "FLOOR_UP")
		        self:SpawnFloorPortal("Floor3DownPortal", Vector3(-6.8, -0.15, 0), "2층으로 내려가기", "FLOOR_DOWN")
	end

	@ExecSpace("ServerOnly")
	method void SpawnFloorPortal(string entityName, Vector3 position, string actionName, string routeId)
		        local path = "/maps/map01/" .. entityName
		        local existing = _EntityService:GetEntityByPath(path)
		        if existing ~= nil and isvalid(existing) then return end
		        local portal = _SpawnService:SpawnByModelId("lexioexit", entityName, position, self.Entity.CurrentMap)
		        if portal == nil then log("[LexioTravelMapController] FLOOR_PORTAL_FAILED name=" .. entityName); return end
		        if portal.InteractionComponent ~= nil then
		            portal.InteractionComponent.ActionName = actionName
		            portal.InteractionComponent.ActionKey = KeyboardKey.UpArrow
		                portal.InteractionComponent.BoxSize = Vector2(0.9, 1.2)
		        end
		        local travel = portal:GetComponent("script.LexioTravelInteractable")
		        if travel ~= nil then travel.RouteId = routeId; travel.ObjectKey = entityName end
		        log("[LexioTravelMapController] FLOOR_PORTAL name=" .. entityName .. " route=" .. routeId)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		        self.scanElapsed = self.scanElapsed + delta
		        if self.scanElapsed < 0.5 then return end
		        self.scanElapsed = 0
		        self:AttachCurrentPlayers()
	end

	@ExecSpace("ServerOnly")
	method void AttachCurrentPlayers()
		        local players = _UserService:GetUsersByMapComponent(self.Entity.CurrentMap.MapComponent)
		        if players == nil then return end
		        for _, player in ipairs(players) do self:AttachBridge(player) end
	end

	@ExecSpace("ServerOnly")
	method void AttachBridge(Entity playerEntity)
		        if playerEntity == nil or not isvalid(playerEntity) or playerEntity.PlayerComponent == nil then return end
		        if playerEntity.CurrentMap ~= self.Entity.CurrentMap then return end
		        local bridge = playerEntity:GetComponent("script.LexioTravelBridge")
		        if bridge == nil then bridge = playerEntity:AddComponent("script.LexioTravelBridge") end
		        if bridge == nil then return end
		        if self.EnableManualTestHooks and (self.ManagedMapName == "TileMapTemplate" or self.ManagedMapName == "boardgame_cafe" or self.ManagedMapName == "map01") then
		            local controls = playerEntity:GetComponent("script.LexioManualTestControls")
		            if controls == nil then controls = playerEntity:AddComponent("script.LexioManualTestControls") end
		            if controls ~= nil then controls:BindTestUser(playerEntity.PlayerComponent.UserId) end
		        end
		        if bridge.boundUserId == playerEntity.PlayerComponent.UserId and bridge.allowedMapName == self.ManagedMapName then return end
		        bridge:BindServer(playerEntity, playerEntity.PlayerComponent.UserId, self.ManagedMapName)
		        log("[LexioTravelMapController] BRIDGE bound userId=" .. playerEntity.PlayerComponent.UserId .. " map=" .. self.ManagedMapName)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		        local playerEntity = _UserService:GetUserEntityByUserId(event.UserId)
		        self:AttachBridge(playerEntity)
	end

end